   "type": "grammar",
   "title": "Plans and intentions",
   "rule": "Önceden verilen karar: am/is/are going to + yalın fiil. Olumsuzda am/is/are'dan sonra not gelir.",
   "grammarId": "going-to-plans",
   "examples": [
    {
     "en": "We *are going to make* a planet model.",
     "tr": "Bir gezegen modeli yapacağız.",
     "trEm": [
      "yapacağız"
     ],
     "textOnly": true
    }
   ]
  },
