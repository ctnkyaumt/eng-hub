    hlPath.push({ x, y }); ctx.putImageData(hlSnapshot, 0, 0); ctx.save();
    ctx.globalAlpha = 0.28; ctx.globalCompositeOperation = 'source-over';
    ctx.strokeStyle = '#FFD600'; ctx.lineWidth = 22; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); ctx.moveTo(hlPath[0].x, hlPath[0].y);
    for (let i = 1; i < hlPath.length; i++) ctx.lineTo(hlPath[i].x, hlPath[i].y);
