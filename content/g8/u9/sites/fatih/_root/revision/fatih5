<script>
const canvas = document.getElementById('drawCanvas');
const ctx = canvas.getContext('2d');
let drawing = false, currentTool = null, hlSnapshot = null, hlPath = [];
function resizeCanvas() {
  const tmp = canvas.toDataURL();
  canvas.width = window.innerWidth; canvas.height = window.innerHeight;
  const img = new Image(); img.onload = () => ctx.drawImage(img, 0, 0); img.src = tmp;
}
window.addEventListener('resize', resizeCanvas); resizeCanvas();
function setTool(tool) {
  if (currentTool === tool) { endDrawing(); return; }
  currentTool = tool; canvas.style.pointerEvents = 'auto';
  ['btnPen','btnHighlight','btnEraser'].forEach(id => document.getElementById(id).classList.remove('active','active-highlight'));
  if (tool === 'pen')       document.getElementById('btnPen').classList.add('active');
  if (tool === 'highlight') document.getElementById('btnHighlight').classList.add('active-highlight');
  if (tool === 'eraser')    document.getElementById('btnEraser').classList.add('active');
  canvas.style.cursor = tool === 'eraser' ? 'cell' : 'crosshair';
}
function endDrawing() {
  currentTool = null; canvas.style.pointerEvents = 'none'; canvas.style.cursor = 'default';
  ['btnPen','btnHighlight','btnEraser'].forEach(id => document.getElementById(id).classList.remove('active','active-highlight'));
}
function clearCanvas() { ctx.clearRect(0, 0, canvas.width, canvas.height); }
