  },
  {
    num: 2,
    instruction: 'Read the information about Sophia and answer the question.',
    imgSide: '<div class="q-text-box"><p>Sophia wants to go on a nature holiday. She loves animals and taking photos. She plans to go camping and try a new water sport. She also wants to visit a national park.</p></div>',
    question: 'According to the information, which tour should Sophia choose?',
    options: [
      'Muğla Tour: Visit the ancient city and stay at a small boutique hotel.',
      'Edirne Tour: Visit the historical mosque and stay at an old mansion.',
      'Burdur Tour: Go camping near the lake, try a water sport and see birds.',
      'Bursa Tour: Visit the high mountains, go skiing and stay in a cabin.'
    ],
    ans: 'C'
  },
