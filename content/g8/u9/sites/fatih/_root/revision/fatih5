}
.test-sub { font-size: 14px; font-weight: 600; opacity: 0.85; margin-top: 4px; letter-spacing: 0; text-transform: none; }

.test-meta {
  display: flex; align-items: stretch; justify-content: space-between;
  font-size: 15px; font-weight: 700;
}
.test-meta-level {
  background: #E3F2FD; color: #1565C0;
  padding: 8px 18px; white-space: nowrap;
}
.test-meta-authors {
  background: #FFFDE7; color: #7B5800;
  padding: 8px 18px; flex: 1;
}

.test-q-wrap { padding: 16px 14px 8px; }
.test-q-box {
  background: #F8F9FA;
  border: 2px solid #E0E0E0;
  border-radius: 12px;
  padding: 16px 18px;
  margin-bottom: 14px;
}
.test-q-label {
  font-size: 19px; font-weight: 700; color: #1565C0;
  margin-bottom: 10px; display: flex; align-items: flex-start; gap: 8px;
}
.test-q-num {
  background: #F57C00; color: #fff;
  border-radius: 50%; width: 28px; height: 28px;
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.q-img-opts { display: flex; gap: 16px; align-items: flex-start; }
.q-img-side { flex: 1; min-width: 0; }
.q-img-side img {
  width: 100%;
  max-height: calc(100vh - 320px);
  object-fit: contain;
  border-radius: 8px;
  display: block;
}
.q-opts-side { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }

.q-text-box {
  background: #FFF3E0;
  border: 2px solid #FFCC80;
  border-radius: 10px;
  padding: 18px 20px;
  font-size: 19px;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.8;
  width: 100%;
}
.q-text-box p { margin-bottom: 6px; }
.q-text-box p:last-child { margin-bottom: 0; }
.q-text-box hr { border: none; border-top: 2px dashed #FFCC80; margin: 10px 0; }

.q-blank { color: #F57C00; font-weight: 900; }

.q-opts-grid2x2 {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.test-opt-img {
  border: 2px solid #CFD8DC; border-radius: 10px;
  background: #fff; padding: 8px;
  cursor: pointer; transition: all 0.15s;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  font-size: 14px; font-weight: 700; color: #333;
}
.test-opt-img:hover { border-color: #F57C00; background: #FFF3E0; }
.test-opt-img img { width: 90%; margin: 0 auto; display: block; border-radius: 6px; }
.test-opt-img.answered  { pointer-events: none; }
.test-opt-img.correct   { border-color: #4CAF50; background: #E8F5E9; color: #1B5E20; }
.test-opt-img.wrong     { border-color: #F44336; background: #FFEBEE; color: #B71C1C; }

.q-table {
  width: 100%; border-collapse: collapse; font-size: 16px; font-weight: 600;
}
.q-table th {
  background: #F57C00; color: #fff;
  padding: 8px 12px; text-align: center; font-weight: 800;
}
.q-table td {
  border: 1px solid #FFCC80; padding: 7px 12px;
  text-align: center; color: #333;
}
.q-table tr:nth-child(even) td { background: #FFF3E0; }
.q-table tr:nth-child(odd) td { background: #fff; }

.test-opt {
  border: 2px solid #CFD8DC; border-radius: 10px;
  background: #fff; padding: 10px 14px;
  font-size: 19px; font-weight: 600; color: #333;
  cursor: pointer; font-family: inherit; text-align: left;
  transition: all 0.15s; display: flex; align-items: center; gap: 10px;
}
.test-opt:hover { border-color: #F57C00; background: #FFF3E0; }
.test-opt .opt-letter {
  background: #F57C00; color: #fff;
  border-radius: 6px; width: 26px; height: 26px;
  font-size: 13px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.test-opt.answered  { pointer-events: none; }
.test-opt.correct   { border-color: #4CAF50; background: #E8F5E9; color: #1B5E20; }
.test-opt.correct .opt-letter { background: #4CAF50; }
.test-opt.wrong     { border-color: #F44336; background: #FFEBEE; color: #B71C1C; }
.test-opt.wrong .opt-letter   { background: #F44336; }

.btn-row { display: flex; justify-content: center; gap: 16px; padding: 14px; }
.btn {
  border: none; border-radius: 28px;
  font-size: 15px; font-weight: 700; padding: 12px 36px;
  cursor: pointer; font-family: inherit; transition: all 0.2s;
}
.btn-check { background: #F57C00; color: #fff; }
.btn-check:hover { background: #E65100; transform: translateY(-2px); }
.btn-reset { background: #607D8B; color: #fff; }
.btn-reset:hover { background: #455A64; }
.btn-next { background: #1565C0; color: #fff; }
.btn-next:hover { background: #0D47A1; transform: translateY(-2px); }
.btn-timer { background: #00796B; color: #fff; min-width: 130px; }
.btn-timer:hover { background: #004D40; transform: translateY(-2px); }
.btn-timer.warning { background: #E65100; }
.btn-timer.danger  { background: #B71C1C; }

.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #9E9E9E; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

.bottom-bar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9999;
  background: #fff; border-top: 3px solid #E65100;
  display: flex; align-items: center; justify-content: center;
  gap: 12px; padding: 10px 20px;
  box-shadow: 0 -3px 16px rgba(0,0,0,0.15);
}
.bar-btn { border: none; border-radius: 8px; font-size: 14px; font-weight: 800; padding: 8px 18px; cursor: pointer; font-family: inherit; transition: all 0.18s; white-space: nowrap; }
.bar-btn-fs { background: #E65100; color: #fff; border: 2px solid #E65100; }
.bar-btn-fs:hover { background: #38006b; border-color: #38006b; }
.bar-btn-zoom { background: transparent; color: #E65100; border: 2px solid rgba(230,81,0,0.4); font-size: 18px; padding: 6px 16px; }
.bar-btn-zoom:hover { background: rgba(230,81,0,0.08); border-color: #E65100; }
.bar-zoom-label { color: #555; font-size: 13px; font-weight: 700; min-width: 40px; text-align: center; }
.bar-divider { width: 1px; height: 32px; background: rgba(74,20,140,0.2); flex-shrink: 0; }
.bar-btn-draw { background: transparent; color: #333; border: 2px solid rgba(0,0,0,0.2); font-size: 13px; padding: 7px 14px; gap: 5px; display: flex; align-items: center; }
.bar-btn-draw:hover { background: rgba(0,0,0,0.06); border-color: #555; }
.bar-btn-draw.active { background: #E65100; color: #fff; border-color: #E65100; }
.bar-btn-draw.active-highlight { background: #FFF176; color: #333; border-color: #e6c800; }
.bar-btn-clear { background: transparent; color: #C62828; border: 2px solid rgba(198,40,40,0.35); font-size: 13px; padding: 7px 14px; }
.bar-btn-clear:hover { background: rgba(198,40,40,0.08); border-color: #C62828; }
.bar-btn-end { background: #E65100; color: #fff; border: 2px solid #E65100; font-size: 13px; padding: 7px 14px; }
.bar-btn-end:hover { background: #38006b; border-color: #38006b; }
.bar-logo { height: 32px; opacity: 0.7; flex-shrink: 0; }
.bar-btn-home { background: transparent; color: #E65100; border: 2px solid rgba(230,81,0,0.4); border-radius: 8px; font-size: 20px; padding: 5px 12px; text-decoration: none; transition: all 0.18s; line-height: 1; }
.bar-btn-home:hover { background: rgba(230,81,0,0.08); border-color: #E65100; }
.bar-clock { margin-left: auto; font-size: 18px; font-weight: 800; color: #E65100; letter-spacing: 1px; flex-shrink: 0; }
#drawCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9998; pointer-events: none; cursor: crosshair; }
@media (max-width: 1024px) { .bottom-bar { display: none; } body { padding-bottom: 20px; } }


/* ── Sonuç Bölümü ── */
.result-section {
  margin: 0 14px 20px;
  background: #fff;
  border: 2px solid #E8EDF5;
  border-radius: 16px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  padding: 20px 18px 18px;
  overflow: hidden;
}
.result-title {
