.bar-btn { border: none; border-radius: 8px; font-size: 14px; font-weight: 800; padding: 8px 18px; cursor: pointer; font-family: inherit; transition: all 0.18s; white-space: nowrap; }
.bar-btn-fs { background: #E65100; color: #fff; border: 2px solid #E65100; }
.bar-btn-fs:hover { background: #38006b; border-color: #38006b; }
.bar-btn-zoom { background: transparent; color: #E65100; border: 2px solid rgba(230,81,0,0.4); font-size: 18px; padding: 6px 16px; }
.bar-btn-zoom:hover { background: rgba(230,81,0,0.08); border-color: #E65100; }
.bar-zoom-label { color: #555; font-size: 13px; font-weight: 700; min-width: 40px; text-align: center; }
.bar-divider { width: 1px; height: 32px; background: rgba(74,20,140,0.2); flex-shrink: 0; }
.bar-btn-draw { background: transparent; color: #333; border: 2px solid rgba(0,0,0,0.2); font-size: 13px; padding: 7px 14px; gap: 5px; display: flex; align-items: center; }
.bar-btn-draw:hover { background: rgba(0,0,0,0.06); border-color: #555; }
.bar-btn-draw.active { background: #E65100; color: #fff; border-color: #E65100; }
.bar-btn-draw.active-highlight { background: #FFF176; color: #333; border-color: #e6c800; }
.bar-btn-clear { background: transparent; color: #C62828; border: 2px solid rgba(198,40,40,0.35); font-size: 13px; padding: 7px 14px; }
.bar-btn-clear:hover { background: rgba(198,40,40,0.08); border-color: #C62828; }
.bar-btn-end { background: #E65100; color: #fff; border: 2px solid #E65100; font-size: 13px; padding: 7px 14px; }
.bar-btn-end:hover { background: #38006b; border-color: #38006b; }
.bar-logo { height: 32px; opacity: 0.7; flex-shrink: 0; }
.bar-btn-home { background: transparent; color: #E65100; border: 2px solid rgba(230,81,0,0.4); border-radius: 8px; font-size: 20px; padding: 5px 12px; text-decoration: none; transition: all 0.18s; line-height: 1; }
.bar-btn-home:hover { background: rgba(230,81,0,0.08); border-color: #E65100; }
.bar-clock { margin-left: auto; font-size: 18px; font-weight: 800; color: #E65100; letter-spacing: 1px; flex-shrink: 0; }
