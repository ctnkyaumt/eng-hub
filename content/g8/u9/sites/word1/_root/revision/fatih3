/* ── Sonuç Bölümü ── */
.result-section {
  margin: 0 14px 20px;
  background: #fff;
  border: 2px solid #E8EDF5;
  border-radius: 16px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
