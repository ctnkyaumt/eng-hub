<script>
const TEST_QUESTIONS = [
  {
    num: 1,
    instruction: 'Two friends, Buse and Tarık, are chatting about their holiday plans.',
    imgSide: '<div class="q-text-box"><p><strong>Buse:</strong> Tarık, have you decided where to go this summer?</p><p><strong>Tarık:</strong> Yes! I\'m going to Cappadocia. I\'ve always wanted to see the fairy chimneys and go on a hot air balloon ride.</p><p><strong>Buse:</strong> That sounds amazing! How long are you staying?</p><p><strong>Tarık:</strong> Four days. We\'re staying at a cave hotel.</p><p><strong>Buse:</strong> Wow! Are you going alone?</p><p><strong>Tarık:</strong> No, I\'m going with my family.</p><p><strong>Buse:</strong> Have a great time!</p></div>',
    question: 'Which of the following questions does Buse NOT ask Tarık?',
    options: [
      'Where are you going?',
      'How long are you staying?',
      'Are you going alone?',
      'How much does the hotel cost?'
    ],
    ans: 'D'
  },
  {
    num: 2,
    instruction: 'Read the emergency announcement and answer the question.',
    imgSide: '<div class="q-text-box"><p style="font-weight:900;text-align:center;margin-bottom:10px;">⚠ STORM WARNING</p><p style="text-align:center;">A severe storm is expected on Friday evening.</p><p style="text-align:center;">Stay indoors after 6 p.m.</p><p style="text-align:center;">Do not park vehicles under trees.</p><p style="text-align:center;">Prepare an emergency kit: torch, water, food for 3 days.</p><p style="text-align:center;">Follow official social media accounts for updates.</p></div>',
    question: 'According to the announcement, which of the following is NOT recommended?',
    options: [
      'Going outside after 6 p.m. on Friday',
      'Preparing food supplies for three days',
      'Keeping a torch in the emergency kit',
      'Following official social media accounts'
    ],
    ans: 'A'
  },
  {
    num: 3,
    instruction: 'Read the news article and answer the question.',
    imgSide: '<div class="q-text-box"><p style="font-weight:900;text-align:center;margin-bottom:10px;">FLOOD HITS COASTAL TOWN</p><p>Heavy rain caused severe flooding in the town of Greenport last Tuesday. The river overflowed, damaging hundreds of homes and forcing over 2,000 residents to evacuate. Emergency teams worked non-stop to rescue people trapped in their houses. Local authorities have warned that more rain is expected this week.</p></div>',
    question: 'According to the article, which of the following is correct?',
    options: [
      'The flooding happened due to an earthquake.',
      'More than 2,000 people had to leave their homes.',
      'The weather is expected to improve this week.',
      'No homes were damaged in the flood.'
    ],
    ans: 'B'
