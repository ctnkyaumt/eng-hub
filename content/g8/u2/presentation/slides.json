  {
   "type": "grammar",
   "title": "Simple Present — Routines",
   "titleTr": "Geniş zaman: günlük hayat",
   "rule": "Alışkanlıklardan ve düzenli işlerden bahsederken geniş zaman kullanırız. He / She / It ile fiile *-s* eklenir.",
   "chips": [
    "always",
    "usually",
    "often",
    "sometimes",
    "never"
   ],
   "examples": [
    {
     "en": "I *go* to the gym twice a week.",
     "tr": "Haftada iki kez spor salonuna giderim.",
     "emoji": "🏋️"
    },
    {
     "en": "She *watches* TV series in her free time.",
     "tr": "O boş zamanında dizi izler.",
     "emoji": "🕒"
    },
    {
     "en": "We *don't* stay up late on school nights.",
     "tr": "Okul gecelerinde geç saate kadar oturmayız.",
     "emoji": "🏫"
    },
    {
     "en": "*Does* he play the guitar? — Yes, he does.",
     "tr": "O gitar çalar mı? — Evet, çalar.",
     "emoji": "🎸"
    }
   ]
  },
