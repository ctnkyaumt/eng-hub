<script>
const TEST_QUESTIONS = [
  {
    num: 1,
    content: `John doesn't want to spend a lot of money on his holiday. He is looking for a <b>…………</b> hotel near the seaside.`,
    options: ['crowded', 'historic', 'cheap', 'noisy'],
    ans: 'C'
  },
  {
    num: 2,
    content: `Claire doesn't like paying for meals and activities. She always stays at a(n) <b>…………</b> hotel because everything is ready for her.`,
    options: ['clean', 'all-inclusive', 'urban', 'ancient'],
    ans: 'B'
  },
  {
    num: 3,
    content: `Ryan visited Rome with his school. The old buildings and temples were amazing, and he never saw such beautiful <b>…………</b> before.`,
    options: ['abroad', 'culture', 'heritage', 'architecture'],
    ans: 'D'
  },
  {
    num: 4,
    content: `Chloe doesn't like busy cities or historic sites. She prefers spending her holiday at the <b>…………</b> because it is more relaxing than going on a sightseeing tour.`,
    options: ['seaside', 'amphitheater', 'temples', 'vacation'],
    ans: 'A'
  },
  {
    num: 5,
    content: `Tom didn't want to miss a room on the cruise ship. Before the holiday, he called the company and <b>…………</b> a room for himself and Martha.`,
    options: ['tasted', 'explored', 'booked', 'packed'],
    ans: 'C'
  },
  {
    num: 6,
    content: `Rose didn't want to travel by plane. She booked a room on a <b>…………</b> and planned to sail at night and visit the islands during the day.`,
    options: ['resort', 'destination', 'attraction', 'cruise'],
    ans: 'D'
  },
  {
    num: 7,
    content: `Maria doesn't like staying in big and crowded cities. She prefers quiet and green areas away from the city. She loves the natural beauty of the <b>…………</b> .`,
    options: ['countryside', 'resort', 'architecture', 'heritage'],
    ans: 'A'
  },
  {
    num: 8,
    content: `Jane loves travelling by ship. She told us that sailing at night and visiting the islands during the day is much more <b>…………</b> than travelling by plane.`,
    options: ['national', 'delicious', 'famous', 'enjoyable'],
    ans: 'D'
  },
  {
    num: 9,
    content: `Jim thinks all-inclusive hotels are the best option for a holiday. However, Sue cannot stay there because the price is too high. It is too <b>…………</b> for her.`,
    options: ['dirty', 'cheap', 'expensive', 'clean'],
    ans: 'C'
  },
  {
    num: 10,
    content: `Stella had a wonderful time in Istanbul. Turkish people were kind and <b>…………</b> .`,
    options: ['noisy', 'rude', 'expensive', 'hospitable'],
    ans: 'D'
  },
  {
    num: 11,
    content: `Peter admired Turkish people during his holiday in Istanbul. They took good care of their historical and <b>………..  </b> heritage.`,
    options: ['natural', 'hospitable', 'cheap', 'urban'],
    ans: 'A'
  },
  {
    num: 12,
    content: `Laura didn't enjoy her time in Paris at all. The streets were full of people and cars. She couldn't sleep well at night because the city was too <b>…………</b> for her.`,
    options: ['fascinating', 'noisy', 'incredible', 'cultural'],
    ans: 'B'
  },
  {
    num: 13,
    content: `Riley thinks that she would rather book a room on a cruise <b>……………</b> for their Caribbean holiday.`,
    options: ['bus', 'plane', 'ship', 'train'],
    ans: 'C'
  },
  {
    num: 14,
    content: `Griffin loves all-inclusive hotels because everything is ready for him. He always chooses to <b>…………</b> at an all-inclusive hotel when he goes on holiday.`,
    options: ['taste', 'explore', 'stay', 'travel'],
    ans: 'C'
  },
  {
    num: 15,
    content: `Lena loved everything about Istanbul. The city was ancient and beautiful. The <b>…………</b> was perfect during her holiday there.`,
    options: ['weather', 'souvenir', 'plane', 'cruise'],
    ans: 'A'
  },
  {
    num: 16,
    content: `Oliver thinks that Istanbul is one of the most beautiful cities in the world. He would like to <b>…………</b> it again.`,
    options: ['prepare', 'visit', 'stay', 'book'],
    ans: 'B'
  },
  {
    num: 17,
    content: `Janet enjoyed her holiday in Istanbul very much. She visited museums and historic sites. She also tasted <b>…………</b> dishes like kebab and lahmacun.`,
    options: ['attractive', 'religious', 'traditional', 'historical'],
    ans: 'C'
  },
  {
    num: 18,
    content: `Oscar doesn't enjoy busy sightseeing tours or crowded cities. He prefers going to the seaside because it is more <b>…………</b> than staying in an urban area.`,
    options: ['ancient', 'relaxing', 'crowded', 'expensive'],
    ans: 'B'
  },
  {
    num: 19,
    content: `Harry and his classmates visited many famous places in Rome. The Colosseum was the most popular tourist <b>…………</b> they saw on their school trip.`,
    options: ['attraction', 'city', 'accommodation', 'weather'],
    ans: 'A'
  },
  {
    num: 20,
    content: `To me, Antalya is a wonderful place to visit. We can swim in the <b>…………</b> water and sunbath on the golden beaches there.`,
    options: ['expensive', 'dirty', 'noisy', 'clean'],
    ans: 'D'
  },
];

let testSelections = {};

function buildTest() {
  const wrap = document.getElementById('testWrap');
  wrap.innerHTML = '';
  TEST_QUESTIONS.forEach((q, qi) => {
    const box = document.createElement('div');
    box.className = 'test-q-box';
    box.id = `qbox-${qi}`;

    const label = document.createElement('div');
    label.className = 'test-q-label';
    label.innerHTML = `<span class="test-q-num">${q.num}</span><span>Choose the correct word.</span>`;
    box.appendChild(label);

    const qWrap = document.createElement('div');
    qWrap.className = 'q-img-opts';

    // Sol: metin kutusu
    const leftSide = document.createElement('div');
    leftSide.className = 'q-img-side';
    const cb = document.createElement('div');
    cb.className = 'test-content-box';
    cb.innerHTML = q.content;
    leftSide.appendChild(cb);
    qWrap.appendChild(leftSide);

    // Sağ: şıklar
    const optsSide = document.createElement('div');
    optsSide.className = 'q-opts-side';
    ['A','B','C','D'].forEach((letter, li) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'test-opt';
      btn.id = `topt-${qi}-${letter}`;
      btn.innerHTML = `<span class="opt-letter">${letter}</span>${q.options[li]}`;
      btn.addEventListener('click', () => revealAnswer(qi, letter));
      optsSide.appendChild(btn);
    });
    qWrap.appendChild(optsSide);
    box.appendChild(qWrap);

    // Buton satırı
    const qBtnRow = document.createElement('div');
    qBtnRow.style.cssText = 'display:flex;align-items:center;gap:10px;margin-top:12px;';

    const showBtn = document.createElement('button');
    showBtn.type = 'button';
    showBtn.className = 'btn btn-check';
    showBtn.style.cssText = 'font-size:13px;padding:8px 22px;';
    showBtn.textContent = '👁 Show Answer';
    showBtn.addEventListener('click', () => revealAnswer(qi, null));
    qBtnRow.appendChild(showBtn);

    const resetBtn = document.createElement('button');
    resetBtn.type = 'button';
    resetBtn.className = 'btn btn-reset';
    resetBtn.style.cssText = 'font-size:13px;padding:8px 18px;';
    resetBtn.textContent = '↺';
    resetBtn.addEventListener('click', () => resetSingleQ(qi));
    qBtnRow.appendChild(resetBtn);

    const feedbackEl = document.createElement('span');
    feedbackEl.id = `tfeedback-${qi}`;
    feedbackEl.style.cssText = 'font-size:14px;font-weight:700;';
    qBtnRow.appendChild(feedbackEl);

    // Timer
    const timerBtn = document.createElement('button');
    timerBtn.type = 'button';
    timerBtn.className = 'btn btn-timer';
    timerBtn.style.cssText = 'font-size:13px;padding:8px 22px;margin-left:auto;';
    timerBtn.textContent = '⏱ Start Timer';
    timerBtn.id = `timer-${qi}`;
    timerBtn.addEventListener('click', () => startTimer(qi));
    qBtnRow.appendChild(timerBtn);

    // Next Question
    if (qi < TEST_QUESTIONS.length - 1) {
      const nextBtn = document.createElement('button');
      nextBtn.type = 'button';
      nextBtn.className = 'btn btn-next';
      nextBtn.style.cssText = 'font-size:13px;padding:8px 22px;';
      nextBtn.textContent = 'Next Question ↓';
      nextBtn.addEventListener('click', () => {
        const nextBox = document.getElementById(`qbox-${qi + 1}`);
        if (nextBox) nextBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      qBtnRow.appendChild(nextBtn);
    }

    box.appendChild(qBtnRow);
    wrap.appendChild(box);
  });
}

function revealAnswer(qi, selected) {
  const q = TEST_QUESTIONS[qi];
  const fb = document.getElementById(`tfeedback-${qi}`);

  ['A','B','C','D'].forEach(l => {
    const b = document.getElementById(`topt-${qi}-${l}`);
    b.classList.remove('selected','correct','wrong','answered');
    b.classList.add('answered');
  });
  document.getElementById(`topt-${qi}-${q.ans}`).classList.add('correct');

  if (selected === null) {
    fb.style.color = '#1565C0'; fb.textContent = `✓ Answer: ${q.ans}`;
  } else if (selected === q.ans) {
    fb.style.color = '#2E7D32'; fb.textContent = '🎉 Correct!';
  } else {
    document.getElementById(`topt-${qi}-${selected}`).classList.add('wrong');
    fb.style.color = '#B71C1C'; fb.textContent = `✗ The answer is ${q.ans}`;
  }
  testSelections[qi] = selected || q.ans;
}

function resetSingleQ(qi) {
  delete testSelections[qi];
  ['A','B','C','D'].forEach(l => {
    const b = document.getElementById(`topt-${qi}-${l}`);
    if (b) b.classList.remove('selected','correct','wrong','answered');
  });
  const fb = document.getElementById(`tfeedback-${qi}`);
  if (fb) fb.textContent = '';
  stopTimer(qi);
}

function resetTest() {
  testSelections = {};
  TEST_QUESTIONS.forEach((_, qi) => resetSingleQ(qi));
}

// ── Timer ──
const timerIntervals = {};

function startTimer(qi) {
  const btn = document.getElementById(`timer-${qi}`);
  if (!btn) return;
  if (timerIntervals[qi]) { stopTimer(qi); return; }

  let remaining = 60;
  updateTimerBtn(btn, remaining);

  timerIntervals[qi] = setInterval(() => {
    remaining--;
    updateTimerBtn(btn, remaining);
    if (remaining <= 10) btn.className = 'btn btn-timer danger';
    else if (remaining <= 30) btn.className = 'btn btn-timer warning';
    if (remaining <= 0) {
      clearInterval(timerIntervals[qi]);
      delete timerIntervals[qi];
      btn.className = 'btn btn-timer danger';
      btn.textContent = '⏱ 0:00';
      playBeep();
    }
  }, 1000);
}

function stopTimer(qi) {
  if (timerIntervals[qi]) { clearInterval(timerIntervals[qi]); delete timerIntervals[qi]; }
  const btn = document.getElementById(`timer-${qi}`);
  if (btn) { btn.className = 'btn btn-timer'; btn.textContent = '⏱ Start Timer'; }
}

function updateTimerBtn(btn, seconds) {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  btn.textContent = `⏱ ${m}:${s.toString().padStart(2,'0')}`;
}

function playBeep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [0, 0.3, 0.6].forEach(delay => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine'; osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.6, ctx.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + 0.4);
      osc.start(ctx.currentTime + delay);
      osc.stop(ctx.currentTime + delay + 0.4);
    });
  } catch(e) {}
}

buildTest();

// ── Kopyalama koruması ──
document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && ['a','c','s','u','p'].includes(e.key.toLowerCase())) e.preventDefault();
  if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && ['i','j','c'].includes(e.key.toLowerCase()))) e.preventDefault();
});
document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('selectstart', e => e.preventDefault());
document.addEventListener('copy',        e => e.preventDefault());
document.addEventListener('cut',         e => e.preventDefault());
document.addEventListener('dragstart',   e => e.preventDefault());

// ── Fullscreen ──
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(() => {});
    document.getElementById('fsBtn').textContent = '✕ Tam Ekrandan Çık';
    document.getElementById('barFsBtn').textContent = '✕ Tam Ekrandan Çık';
  } else {
    document.exitFullscreen();
    document.getElementById('fsBtn').textContent = '⛶ Tam Ekran';
    document.getElementById('barFsBtn').textContent = '⛶ Tam Ekran';
  }
}
document.addEventListener('fullscreenchange', () => {
  if (!document.fullscreenElement) {
    document.getElementById('fsBtn').textContent = '⛶ Tam Ekran';
    document.getElementById('barFsBtn').textContent = '⛶ Tam Ekran';
  }
});
</script>

