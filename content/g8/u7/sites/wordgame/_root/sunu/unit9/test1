<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #e8edf2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 8px 80px;
}

.color-bar, .color-bar-bottom, .page { width: calc(100% - 20px); max-width: 1900px; }
.color-bar, .color-bar-bottom { display: flex; height: 13px; overflow: hidden; }
.color-bar { border-radius: 8px 8px 0 0; }
.color-bar-bottom { border-radius: 0 0 8px 8px; margin-top: -1px; }
.cb1 { background: #EF9A9A; flex: 1; }
.cb2 { background: #A5D6A7; flex: 1; }
.cb3 { background: #90CAF9; flex: 1; }
.cb4 { background: #FFF176; flex: 1; }

.page {
  background: #fff;
  border-radius: 0 0 18px 18px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.13);
  overflow: hidden;
}

.page-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px 14px; border-bottom: 2px solid #f0f0f0; gap: 10px;
}
.nav-links {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 700; color: #aaa; flex-shrink: 0;
}
.nav-links a { color: #1565C0; text-decoration: none; font-weight: 700; transition: color 0.15s; }
.nav-links a:hover { color: #6A1B9A; }
.nav-sep { color: #ccc; font-size: 15px; }
.page-title { text-align: center; flex: 1; }
.page-title .unit-label { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase; }
.page-title h1 { font-size: 22px; font-weight: 900; color: #1a237e; }
.canbay-btn {
  font-size: 13px; font-weight: 800; color: #6A1B9A;
  text-decoration: none; background: #fff;
  border: 2px solid #6A1B9A; border-radius: 8px;
  padding: 6px 14px; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.canbay-btn:hover { background: #F3E5F5; transform: translateY(-1px); }
.fullscreen-btn {
  font-size: 13px; font-weight: 800; color: #1565C0;
  background: #fff; border: 2px solid #1565C0;
  border-radius: 8px; padding: 6px 14px; cursor: pointer;
  font-family: inherit; transition: all 0.18s; white-space: nowrap; flex-shrink: 0;
}
.fullscreen-btn:hover { background: #E3F2FD; transform: translateY(-1px); }

.test-header {
  background: #CE93D8;
  color: #4A148C;
  text-align: center;
  padding: 18px 14px 14px;
  font-size: 22px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase;
}
.test-sub { font-size: 14px; font-weight: 600; opacity: 0.85; margin-top: 4px; letter-spacing: 0; text-transform: none; }

.test-meta {
  display: flex; align-items: stretch; justify-content: space-between;
  font-size: 15px; font-weight: 700;
}
.test-meta-level { background: #F3E5F5; color: #6A1B9A; padding: 8px 18px; white-space: nowrap; }
.test-meta-authors { background: #FFFDE7; color: #7B5800; padding: 8px 18px; flex: 1; }

.test-q-wrap { padding: 16px 14px 8px; }
.test-q-box {
  background: #F8F9FA; border: 2px solid #E0E0E0;
  border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;
}
.test-q-label {
  font-size: 19px; font-weight: 700; color: #6A1B9A;
  margin-bottom: 10px; display: flex; align-items: flex-start; gap: 8px;
}
.test-q-num {
  background: #7B1FA2; color: #fff;
  border-radius: 50%; width: 28px; height: 28px;
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.q-img-opts { display: flex; gap: 16px; align-items: flex-start; }
.q-img-side { flex: 1; min-width: 0; }
.q-img-side img {
  width: 100%; max-height: calc(100vh - 320px);
  object-fit: contain; border-radius: 8px; display: block;
  border: 2px solid #D0D7E2;
}
.q-opts-side { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }

.q-text-box {
  background: #fff; border: 2px solid #D0D7E2;
  border-radius: 10px; padding: 18px 20px;
  font-size: 19px; font-weight: 600; color: #1a1a1a;
  line-height: 1.8; width: 100%;
}
.q-text-box p { margin-bottom: 6px; }
.q-text-box p:last-child { margin-bottom: 0; }
.q-text-box hr { border: none; border-top: 1.5px dashed #D0D7E2; margin: 10px 0; }

.q-text-box-alt {
  background: #fff; border: 2px solid #D0D7E2;
  border-radius: 10px; padding: 18px 20px;
  font-size: 19px; font-weight: 600; color: #1a1a1a;
  line-height: 1.8; width: 100%;
}
.q-text-box-alt p { margin-bottom: 6px; }
.q-text-box-alt p:last-child { margin-bottom: 0; }

.q-table {
  width: 100%; border-collapse: collapse; font-size: 16px; font-weight: 600;
}
.q-table th {
  background: #7B1FA2; color: #fff;
  padding: 8px 12px; text-align: center; font-weight: 800;
}
.q-table td { border: 1px solid #D0D7E2; padding: 7px 12px; color: #333; }
.q-table td:first-child { text-align: center; font-weight: 700; background: #F3E5F5; }
.q-table tr:nth-child(even) td:not(:first-child) { background: #FAF5FF; }
.q-table tr:nth-child(odd)  td:not(:first-child) { background: #fff; }

.test-opt {
  border: 2px solid #CFD8DC; border-radius: 10px;
  background: #fff; padding: 10px 14px;
  font-size: 19px; font-weight: 600; color: #333;
  cursor: pointer; font-family: inherit; text-align: left;
  transition: all 0.15s; display: flex; align-items: center; gap: 10px;
}
.test-opt:hover { border-color: #7B1FA2; background: #F3E5F5; }
.test-opt .opt-letter {
  background: #7B1FA2; color: #fff;
  border-radius: 6px; width: 26px; height: 26px;
  font-size: 13px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.test-opt.answered  { pointer-events: none; }
.test-opt.correct   { border-color: #4CAF50; background: #E8F5E9; color: #1B5E20; }
.test-opt.correct .opt-letter { background: #4CAF50; }
.test-opt.wrong     { border-color: #F44336; background: #FFEBEE; color: #B71C1C; }
.test-opt.wrong .opt-letter   { background: #F44336; }

.q-opts-grid2x2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.test-opt-img { flex-direction: column; align-items: stretch; padding: 8px 10px; }
.test-opt-img .opt-letter { align-self: flex-start; margin-bottom: 6px; }
.test-opt-img img { width: 90%; border-radius: 6px; display: block; object-fit: contain; margin: 0 auto; }

.btn-row { display: flex; justify-content: center; gap: 16px; padding: 14px; }
.btn {
  border: none; border-radius: 28px;
  font-size: 15px; font-weight: 700; padding: 12px 36px;
  cursor: pointer; font-family: inherit; transition: all 0.2s;
}
.btn-check { background: #7B1FA2; color: #fff; }
.btn-check:hover { background: #6A1B9A; transform: translateY(-2px); }
.btn-reset { background: #607D8B; color: #fff; }
.btn-reset:hover { background: #455A64; }
.btn-next { background: #1565C0; color: #fff; }
.btn-next:hover { background: #0D47A1; transform: translateY(-2px); }
.btn-timer { background: #00796B; color: #fff; min-width: 130px; }
.btn-timer:hover { background: #004D40; transform: translateY(-2px); }
.btn-timer.warning { background: #E65100; }
.btn-timer.danger  { background: #B71C1C; }

.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #9E9E9E; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

.bottom-bar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9999;
  background: #fff; border-top: 3px solid #4A148C;
  display: flex; align-items: center; justify-content: center;
  gap: 12px; padding: 10px 20px;
  box-shadow: 0 -3px 16px rgba(0,0,0,0.15);
}
.bar-btn { border: none; border-radius: 8px; font-size: 14px; font-weight: 800; padding: 8px 18px; cursor: pointer; font-family: inherit; transition: all 0.18s; white-space: nowrap; }
.bar-btn-fs { background: #4A148C; color: #fff; border: 2px solid #4A148C; }
.bar-btn-fs:hover { background: #38006b; border-color: #38006b; }
.bar-btn-zoom { background: transparent; color: #4A148C; border: 2px solid rgba(74,20,140,0.4); font-size: 18px; padding: 6px 16px; }
.bar-btn-zoom:hover { background: rgba(74,20,140,0.08); border-color: #4A148C; }
.bar-zoom-label { color: #555; font-size: 13px; font-weight: 700; min-width: 40px; text-align: center; }
.bar-divider { width: 1px; height: 32px; background: rgba(74,20,140,0.2); flex-shrink: 0; }
.bar-btn-draw { background: transparent; color: #333; border: 2px solid rgba(0,0,0,0.2); font-size: 13px; padding: 7px 14px; gap: 5px; display: flex; align-items: center; }
.bar-btn-draw:hover { background: rgba(0,0,0,0.06); border-color: #555; }
.bar-btn-draw.active { background: #4A148C; color: #fff; border-color: #4A148C; }
.bar-btn-draw.active-highlight { background: #FFF176; color: #333; border-color: #e6c800; }
.bar-btn-clear { background: transparent; color: #C62828; border: 2px solid rgba(198,40,40,0.35); font-size: 13px; padding: 7px 14px; }
.bar-btn-clear:hover { background: rgba(198,40,40,0.08); border-color: #C62828; }
.bar-btn-end { background: #4A148C; color: #fff; border: 2px solid #4A148C; font-size: 13px; padding: 7px 14px; }
.bar-btn-end:hover { background: #38006b; border-color: #38006b; }
.bar-logo { height: 32px; opacity: 0.7; flex-shrink: 0; }
.bar-btn-home { background: transparent; color: #4A148C; border: 2px solid rgba(74,20,140,0.4); border-radius: 8px; font-size: 20px; padding: 5px 12px; text-decoration: none; transition: all 0.18s; line-height: 1; }
.bar-btn-home:hover { background: rgba(74,20,140,0.08); border-color: #4A148C; }
.bar-clock { margin-left: auto; font-size: 18px; font-weight: 800; color: #4A148C; letter-spacing: 1px; flex-shrink: 0; }
#drawCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9998; pointer-events: none; cursor: crosshair; }
@media (max-width: 1024px) { .bottom-bar { display: none; } body { padding-bottom: 20px; } }


/* ── Sonuç Bölümü ── */
.result-section { margin: 0 14px 20px; background: #fff; border: 2px solid #E8EDF5; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 20px 18px 18px; overflow: hidden; }
.result-title { font-size: 18px; font-weight: 900; color: #1a237e; text-align: center; margin-bottom: 16px; letter-spacing: 0.5px; }
.result-stats { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; }
.result-stat-card { flex: 1; min-width: 70px; max-width: 110px; border-radius: 12px; padding: 10px 6px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
.stat-num { font-size: 26px; font-weight: 900; line-height: 1; }
.stat-label { font-size: 11px; font-weight: 700; margin-top: 4px; opacity: 0.75; text-transform: uppercase; letter-spacing: 0.5px; }
.stat-total   { background: #E8EDF5; color: #1a237e; }
.stat-correct { background: #E8F5E9; color: #1B5E20; }
.stat-wrong   { background: #FFEBEE; color: #B71C1C; }
.stat-blank   { background: #FFF8E1; color: #7B5800; }
.stat-score   { background: #EDE7F6; color: #4527A0; }
.result-progress-wrap { background: #ECEFF1; border-radius: 99px; height: 10px; margin-bottom: 14px; overflow: hidden; }
.result-progress-bar { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #43A047, #66BB6A); transition: width 0.5s ease; }
.result-table-wrap { overflow-x: auto; margin-top: 14px; }
.result-table { width: 100%; border-collapse: collapse; font-size: 14px; font-weight: 600; }
.result-table thead tr { background: #E3F2FD; }
.result-table th { padding: 8px 12px; text-align: center; color: #1565C0; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
.result-table td { padding: 7px 12px; text-align: center; border-bottom: 1px solid #F0F0F0; }
.result-table tbody tr:last-child td { border-bottom: none; }
.result-table tbody tr.row-correct { background: #F1F8F1; }
.result-table tbody tr.row-wrong   { background: #FFF5F5; }
.result-table tbody tr.row-blank   { background: #FFFDE7; }
.result-table tbody tr.row-shown   { background: #EDE7F6; }
.badge { display: inline-block; border-radius: 6px; padding: 2px 10px; font-size: 12px; font-weight: 800; }
.badge-correct { background: #C8E6C9; color: #1B5E20; }
.badge-wrong   { background: #FFCDD2; color: #B71C1C; }
.badge-blank   { background: #FFF9C4; color: #7B5800; }
.badge-shown   { background: #D1C4E9; color: #4527A0; }
.result-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 4px; }
.res-btn { border: none; border-radius: 28px; font-size: 14px; font-weight: 800; padding: 11px 28px; cursor: pointer; font-family: inherit; transition: all 0.18s; }
.res-btn-dl { background: #1565C0; color: #fff; }
.res-btn-dl:hover { background: #0D47A1; transform: translateY(-2px); }
.res-btn-wa { background: #25D366; color: #fff; }
.res-btn-wa:hover { background: #1DA851; transform: translateY(-2px); }

@media (max-width: 700px) {
  body { padding: 8px 6px 20px; }
  .color-bar, .color-bar-bottom, .page { width: calc(100% - 12px); }
  .page-header { flex-wrap: wrap; padding: 10px 12px 8px; gap: 6px; }
  .nav-links { font-size: 11px; order: 1; flex: 1 1 100%; }
  .page-title { order: 2; flex: 1 1 auto; }
  .page-title h1 { font-size: 16px; }
  .canbay-btn { font-size: 11px; padding: 5px 10px; order: 3; }
  .test-header { font-size: 16px; padding: 14px 10px 10px; }
  .test-q-wrap { padding: 10px 10px 4px; }
  .test-opt { font-size: 14px; }
  .q-img-opts { flex-direction: column; }
  .q-opts-side { width: 100%; }
  .btn { font-size: 13px; padding: 10px 22px; }
  .result-section { margin: 0 6px 16px; padding: 14px 10px; }
  .result-stat-card { min-width: 58px; padding: 8px 4px; }
  .stat-num { font-size: 20px; }
  .result-table { font-size: 12px; }
  .result-table th, .result-table td { padding: 6px 8px; }
  .res-btn { font-size: 13px; padding: 10px 20px; }
}
</style>
