<script>
const CARDS = [
  {
    color: 'c-blue', icon: '🖥️', badge: 'Sunum',
    title: '9. Ünite Sunumu',
    desc: 'Kelime kartları, interaktif test ve iki kişilik kelime oyununu içeren akıllı tahta sunumu.',
    goto: '../sunu/unit9/',
    btnLabel: '🖥️ Sunuma Git'
  },
  {
    color: 'c-red', icon: '📝', badge: 'Test 1',
    title: '8. Sınıf 9. Ünite Test 1',
    desc: 'LGS sınavlarında çıkmış sorulara benzer şekilde hazırlanmış 9. ünite practice test.',
    goto: 'https://drive.google.com/file/d/1HlQGXFUw-I6x0BQQNnqaxuNPNIn1cOYg/view?usp=sharing'
  },
  {
    color: 'c-green', icon: '🔤', badge: 'Kelime Testi',
    title: '8. Sınıf 9. Ünite Kelime Anlam Testi 1',
    desc: '9. ünitenin kelimelerini Türkçe anlamlarıyla ölçen word meaning test. Kelime bilgisini pekiştirmek için idealdir.',
    goto: 'https://drive.google.com/file/d/1Ut5x09VDxnILFbK2Fxx3KHE2YbY_1nKc/view?usp=sharing'
  }
];

function absUrl(href) {
  return new URL(href, location.href).href;
}

function copyLink(href, btn) {
  navigator.clipboard.writeText(absUrl(href)).then(() => {
    btn.classList.add('copied');
    btn.textContent = '✓ Kopyalandı!';
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.textContent = '🔗 Linki Kopyala';
    }, 2000);
  });
}

const grid = document.getElementById('cardGrid');

CARDS.forEach(c => {
  const card = document.createElement('div');
  card.className = `pdf-card ${c.color}`;
  const link = c.pdf || c.goto;
  card.innerHTML = `
    <div class="card-top">
      <div class="card-icon">${c.icon}</div>
      <span class="card-badge">${c.badge}</span>
      <div class="card-title">${c.title}</div>
    </div>
    <div class="card-body">${c.desc}</div>
    <div class="card-btns">
      ${c.pdf
        ? `<a href="${c.pdf}" target="_blank" rel="noopener" class="btn-pdf">📄 PDF'yi Aç</a>`
        : `<a href="${c.goto}" target="_blank" rel="noopener" class="btn-goto">${c.btnLabel || "📄 Drive'da Aç"}</a>`
      }
      <button class="btn-copy" onclick="copyLink('${link}', this)">🔗 Linki Kopyala</button>
    </div>`;
  grid.appendChild(card);
});
</script>

