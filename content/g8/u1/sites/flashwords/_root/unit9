  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 700; color: #aaa; flex-shrink: 0;
}
.nav-links a { color: #1565C0; text-decoration: none; font-weight: 700; transition: color 0.15s; }
.nav-links a:hover { color: #FF5722; }
.nav-sep { color: #ccc; font-size: 15px; }
.page-title { text-align: center; flex: 1; }
.page-title .unit-label { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase; }
.page-title h1 { font-size: 26px; font-weight: 900; color: #0a0f4a; line-height: 1.2; }
.canbay-btn {
  font-size: 13px; font-weight: 800; color: #E53935;
  text-decoration: none; background: #fff;
  border: 2px solid #E53935; border-radius: 8px;
  padding: 6px 14px; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
