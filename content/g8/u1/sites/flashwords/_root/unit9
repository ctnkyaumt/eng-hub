  padding: 14px 16px 20px;
}

.pdf-card {
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 16px rgba(0,0,0,0.09);
  transition: transform 0.2s, box-shadow 0.2s;
}
.pdf-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.15); }

.card-top {
  padding: 20px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  position: relative;
}
.card-icon { font-size: 32px; line-height: 1; margin-bottom: 2px; }
.card-badge {
  font-size: 10px; font-weight: 800; letter-spacing: 0.8px;
  text-transform: uppercase;
  background: rgba(0,0,0,0.07);
  border: 1.5px solid rgba(0,0,0,0.15);
  border-radius: 20px;
  padding: 3px 10px; color: #444;
  position: absolute; top: 12px; right: 12px;
}
.card-title { font-size: 16px; font-weight: 900; color: #1a1a1a; line-height: 1.3; }

.card-body {
  background: #fff;
  padding: 12px 16px;
  font-size: 13px; color: #444;
  line-height: 1.6; flex: 1;
}

.card-btns {
  background: #fff;
  border-top: 1px solid #f0f0f0;
  padding: 10px 12px;
  display: flex; gap: 8px;
}
.btn-pdf, .btn-copy, .btn-goto {
  flex: 1; border: none; border-radius: 8px;
  font-size: 13px; font-weight: 700;
  padding: 9px 6px;
  cursor: pointer; font-family: inherit;
  transition: all 0.18s; text-align: center;
  text-decoration: none;
  display: flex; align-items: center; justify-content: center; gap: 5px;
}
.btn-pdf  { background: #FFEBEE; color: #C62828; border: 1.5px solid #FFCDD2; }
.btn-pdf:hover  { background: #FFCDD2; }
.btn-goto { background: #E3F2FD; color: #1565C0; border: 1.5px solid #BBDEFB; }
.btn-goto:hover { background: #BBDEFB; }
.btn-copy { background: #F5F5F5; color: #333; border: 1.5px solid #E0E0E0; }
.btn-copy:hover { background: #EEEEEE; }
.btn-copy.copied { background: #E8F5E9; color: #2E7D32; border-color: #A5D6A7; }

.c-red    .card-top { background: #FFEBEE; }
.c-green  .card-top { background: #E8F5E9; }
.c-orange .card-top { background: #FFF3E0; }
.c-blue   .card-top { background: #E3F2FD; }
.c-purple .card-top { background: #F3E5F5; }

.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #9E9E9E; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

@media (max-width: 900px) {
  .card-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  body { padding: 8px 6px 20px; }
  .color-bar, .color-bar-bottom, .page { width: calc(100% - 12px); }
  .page-header { padding: 10px 12px 8px; flex-wrap: wrap; gap: 6px; }
  .nav-links { font-size: 11px; order: 1; flex: 1 1 100%; }
  .page-title { order: 2; }
  .page-title h1 { font-size: 18px; }
  .canbay-btn { font-size: 11px; padding: 5px 10px; order: 3; }
  .card-grid { grid-template-columns: 1fr; gap: 10px; padding: 10px 10px 16px; }
}
