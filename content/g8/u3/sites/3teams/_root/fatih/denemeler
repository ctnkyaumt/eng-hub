* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #e8edf2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 8px 40px;
}

.color-bar, .color-bar-bottom, .page {
  width: calc(100% - 20px);
  max-width: 1900px;
}
.color-bar, .color-bar-bottom {
  display: flex; height: 13px; overflow: hidden;
}
.color-bar { border-radius: 8px 8px 0 0; }
.color-bar-bottom { border-radius: 0 0 8px 8px; margin-top: -1px; }
.cb1 { background: #EF9A9A; flex: 1; }
.cb2 { background: #A5D6A7; flex: 1; }
.cb3 { background: #90CAF9; flex: 1; }
.cb4 { background: #FFF176; flex: 1; }

.page {
  background: #fff;
  border-radius: 0 0 18px 18px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.13);
  overflow: hidden;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 14px;
  border-bottom: 2px solid #f0f0f0;
  gap: 10px;
}
.header-logo { height: 48px; width: auto; flex-shrink: 0; }
.header-logo-secondary { height: 36px; width: auto; flex-shrink: 0; }
.nav-links {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 700; color: #aaa; flex-shrink: 0;
}
.nav-links a { color: #1565C0; text-decoration: none; font-weight: 700; transition: color 0.15s; }
.nav-links a:hover { color: #FF5722; }
.nav-sep { color: #ccc; font-size: 15px; }
.page-title { text-align: center; flex: 1; }
.page-title .unit-label { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase; }
.page-title h1 { font-size: 24px; font-weight: 900; color: #0a0f4a; line-height: 1.2; }
.canbay-btn {
  font-size: 13px; font-weight: 800; color: #E53935;
  text-decoration: none; background: #fff;
  border: 2px solid #E53935; border-radius: 8px;
  padding: 6px 14px; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.canbay-btn:hover { background: #FFEBEE; transform: translateY(-1px); }

.subtitle {
  text-align: center;
  padding: 8px 12px 4px;
  font-size: 15px; color: #666; font-weight: 500;
}

.filter-bar {
  display: flex; flex-wrap: wrap; gap: 8px;
  justify-content: center; padding: 8px 16px 4px;
}
.filter-btn {
  border: 2px solid transparent; border-radius: 20px;
  font-size: 13px; font-weight: 800; padding: 7px 20px;
  cursor: pointer; font-family: inherit; transition: all 0.18s;
  letter-spacing: 0.5px;
}
.filter-btn.f-all           { background: #F5F5F5; color: #555; border-color: #E0E0E0; }
.filter-btn.f-all.active    { background: #455A64; color: #fff; border-color: #455A64; }
.filter-btn.f-u1            { background: #E3F2FD; color: #1565C0; border-color: #BBDEFB; }
.filter-btn.f-u1.active     { background: #1565C0; color: #fff; border-color: #1565C0; }
.filter-btn.f-u2            { background: #F3E5F5; color: #7B1FA2; border-color: #E1BEE7; }
.filter-btn.f-u2.active     { background: #7B1FA2; color: #fff; border-color: #7B1FA2; }
.filter-btn.f-u9            { background: #E8F5E9; color: #2E7D32; border-color: #C8E6C9; }
.filter-btn.f-u9.active     { background: #2E7D32; color: #fff; border-color: #2E7D32; }
.filter-btn.f-u10           { background: #FFEBEE; color: #C62828; border-color: #FFCDD2; }
.filter-btn.f-u10.active    { background: #C62828; color: #fff; border-color: #C62828; }
.filter-btn.f-u3            { background: #FFF3E0; color: #E65100; border-color: #FFCCBC; }
.filter-btn.f-u3.active     { background: #E65100; color: #fff; border-color: #E65100; }
.filter-btn.f-u4            { background: #E3F2FD; color: #0277BD; border-color: #B3E5FC; }
.filter-btn.f-u4.active     { background: #0277BD; color: #fff; border-color: #0277BD; }
.filter-btn.f-u5            { background: #E0F7FA; color: #00838F; border-color: #B2EBF2; }
.filter-btn.f-u5.active     { background: #00838F; color: #fff; border-color: #00838F; }
.filter-btn.f-u6            { background: #FFF8E1; color: #F57F17; border-color: #FFE082; }
.filter-btn.f-u6.active     { background: #F57F17; color: #fff; border-color: #F57F17; }
.filter-btn.f-u7            { background: #E8F5E9; color: #2E7D32; border-color: #C8E6C9; }
.filter-btn.f-u7.active     { background: #2E7D32; color: #fff; border-color: #2E7D32; }
.filter-btn.f-u8            { background: #FFF3E0; color: #E65100; border-color: #FFCCBC; }
.filter-btn.f-u8.active     { background: #E65100; color: #fff; border-color: #E65100; }
.filter-btn.f-rev           { background: #ECEFF1; color: #37474F; border-color: #B0BEC5; }
.filter-btn.f-rev.active    { background: #37474F; color: #fff; border-color: #37474F; }

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  padding: 14px 16px 20px;
}

.pdf-card {
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 16px rgba(0,0,0,0.09);
  transition: transform 0.2s, box-shadow 0.2s;
}
.pdf-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.15); }

.card-top {
  padding: 20px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  position: relative;
}
.card-icon { font-size: 32px; line-height: 1; margin-bottom: 2px; }
.card-badge {
  font-size: 10px; font-weight: 800; letter-spacing: 0.8px;
  text-transform: uppercase;
  background: rgba(0,0,0,0.07);
  border: 1.5px solid rgba(0,0,0,0.15);
  border-radius: 20px;
  padding: 3px 10px; color: #444;
  position: absolute; top: 12px; right: 12px;
}
.card-title { font-size: 16px; font-weight: 900; color: #1a1a1a; line-height: 1.3; }
.card-author { font-size: 13px; font-weight: 700; color: #666; }

.card-body {
  background: #fff;
  padding: 12px 16px;
  font-size: 13px; color: #444;
  line-height: 1.6; flex: 1;
}

.card-btns {
  background: #fff;
  border-top: 1px solid #f0f0f0;
  padding: 10px 12px;
  display: flex; gap: 8px;
}
.btn-start, .btn-copy {
  flex: 1; border: none; border-radius: 8px;
  font-size: 13px; font-weight: 700;
  padding: 9px 6px;
  cursor: pointer; font-family: inherit;
  transition: all 0.18s; text-align: center;
  text-decoration: none;
  display: flex; align-items: center; justify-content: center; gap: 5px;
}
.btn-start { background: #E8F5E9; color: #1B5E20; border: 1.5px solid #A5D6A7; }
.btn-start:hover { background: #C8E6C9; }
.btn-copy { background: #F5F5F5; color: #333; border: 1.5px solid #E0E0E0; }
.btn-copy:hover { background: #EEEEEE; }
.btn-copy.copied { background: #E8F5E9; color: #2E7D32; border-color: #A5D6A7; }

.c-blue   .card-top { background: #E3F2FD; }
.c-green  .card-top { background: #E8F5E9; }
.c-red    .card-top { background: #FFEBEE; }
.c-purple .card-top { background: #F3E5F5; }
.c-orange .card-top { background: #FFF3E0; }
.c-teal   .card-top { background: #E0F7FA; }
.c-amber  .card-top { background: #FFF8E1; }
.c-green2 .card-top { background: #E8F5E9; }
.c-slate  .card-top { background: #ECEFF1; }

.section-sep {
  grid-column: 1 / -1;
  display: flex; align-items: center; gap: 14px; padding: 6px 0 2px;
}
.section-sep-line { flex: 1; height: 2px; background: #e0e0e0; border-radius: 2px; }
.section-sep-title {
  font-size: 14px; font-weight: 900; color: #888;
  letter-spacing: 1px; text-transform: uppercase; white-space: nowrap;
}

.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #9E9E9E; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

@media (max-width: 1024px) {
  .card-grid { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 700px) {
  body { padding: 8px 6px 20px; }
  .color-bar, .color-bar-bottom, .page { width: calc(100% - 12px); }
  .page-header { padding: 10px 12px 8px; flex-wrap: wrap; gap: 6px; }
  .nav-links { font-size: 11px; order: 1; flex: 1 1 100%; }
  .page-title { order: 2; }
  .page-title h1 { font-size: 18px; }
  .canbay-btn { font-size: 11px; padding: 5px 10px; order: 3; }
  .card-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 10px 10px 16px; }
}
@media (max-width: 480px) {
  .card-grid { grid-template-columns: 1fr; }
}
</style>
</head>
