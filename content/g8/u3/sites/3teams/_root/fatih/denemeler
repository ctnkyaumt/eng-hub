function absUrl(href) {
  return new URL(href, location.href).href;
}

function copyLink(href, btn) {
  navigator.clipboard.writeText(absUrl(href)).then(() => {
    btn.classList.add('copied');
    btn.textContent = '✓ Kopyalandı!';
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.textContent = '🔗 Linki Kopyala';
    }, 2000);
  });
}

const grid = document.getElementById('cardGrid');
const cardEls = [];

CARDS.forEach(c => {
  const card = document.createElement('div');
  card.className = `pdf-card ${c.color}`;
  card.dataset.unit = c.unit;
  card.innerHTML = `
    <div class="card-top">
      <div class="card-icon">${c.icon}</div>
      <span class="card-badge">${c.badge}</span>
      <div class="card-title">${c.title}</div>
      <div class="card-author">Fatih Sayılan</div>
    </div>
    <div class="card-body">${c.desc}</div>
    <div class="card-btns">
      <a href="${c.start}" class="btn-start">▶ Teste Başla</a>
      <button type="button" class="btn-copy" onclick="copyLink('${c.start}', this)">🔗 Linki Kopyala</button>
    </div>`;
  grid.appendChild(card);
  cardEls.push(card);
});

function setFilter(unit, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  cardEls.forEach(card => {
    card.style.display = (unit === 'all' || card.dataset.unit === unit) ? '' : 'none';
  });
}
