function setFilter(unit, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  cardEls.forEach(card => {
    card.style.display = (unit === 'all' || card.dataset.unit === unit) ? '' : 'none';
