<div class="color-bar">
  <span class="cb1"></span><span class="cb2"></span><span class="cb3"></span><span class="cb4"></span>
  <span class="cb1"></span><span class="cb2"></span><span class="cb3"></span><span class="cb4"></span>
</div>

<div class="page">

  <div class="page-header">
    <a href="../"><img src="../images/favicon.png" alt="Canbay" class="header-logo"></a>
    <div class="nav-links">
      <a href="../">Ana Sayfa</a>
      <span class="nav-sep">/</span>
      <span>Oyunlar</span>
    </div>
    <div class="page-title">
      <div class="unit-label">8. Sınıf İngilizce</div>
      <h1>Kelime Oyunları</h1>
    </div>
    <a href="../" class="canbay-btn">🏠 Ana Sayfa</a>
  </div>

  <div class="subtitle">Oynamak için bir oyuna tıkla.</div>

  <div class="card-grid" id="cardGrid"></div>

  <div class="copyright">
    © 2025-2026 Gönül &amp; İlyas CANBAY | Tüm hakları saklıdır.<br>
