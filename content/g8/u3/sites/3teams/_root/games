  {
    color: 'c-red', icon: '🎯', badge: 'Unit 6 · 2 Kişilik',
    title: 'Adventures Word Clash',
    desc: 'Unit 6 kelimelerinden sorular çıkar. İki oyuncu yarışır: doğru cevap +10, yanlış cevap artan ceza (-2/-4/-6). 3 yanlış yapan o soruda kilitlenir.',
    href: '../sunu/unit6/vocabulary/wordgame.html'
  },
  {
    color: 'c-blue', icon: '🎯', badge: 'Unit 7 · 2 Kişilik',
    title: 'Tourism Word Clash',
    desc: 'Unit 7 kelimelerinden sorular çıkar. İki oyuncu yarışır: doğru cevap +10, yanlış cevap artan ceza (-2/-4/-6). 3 yanlış yapan o soruda kilitlenir.',
    href: '../sunu/unit7/vocabulary/wordgame.html'
  },
  {
    color: 'c-orange', icon: '🎯', badge: 'Unit 8 · 2 Kişilik',
    title: 'Chores Word Clash',
    desc: 'Unit 8 kelimelerinden sorular çıkar. İki oyuncu yarışır: doğru cevap +10, yanlış cevap artan ceza (-2/-4/-6). 3 yanlış yapan o soruda kilitlenir.',
    href: '../sunu/unit8/vocabulary/wordgame.html'
