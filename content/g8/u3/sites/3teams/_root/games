  {
    color: 'c-purple', icon: '🎯', badge: 'Unit 2',
    title: 'Unit 2 Quiz Game',
    desc: '2. Üniteye ait aşamalı bir quiz oyunu.',
    href: '2'
  }
];

const grid = document.getElementById('cardGrid');

CARDS.forEach(c => {
  const card = document.createElement('a');
  card.className = `game-card ${c.color}`;
  card.href = c.href;
  card.innerHTML = `
    <div class="card-top">
      <div class="card-icon">${c.icon}</div>
      <span class="card-badge">${c.badge}</span>
      <div class="card-title">${c.title}</div>
    </div>
    <div class="card-body">${c.desc}</div>
    <div class="card-btn-row">
      <span class="btn-play">🎮 Oyna</span>
    </div>`;
  grid.appendChild(card);
});
</script>

