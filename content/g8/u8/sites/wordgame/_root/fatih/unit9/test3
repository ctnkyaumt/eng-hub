  .test-q-wrap { padding: 10px 10px 4px; }
  .test-opt { font-size: 14px; }
  .q-img-opts { flex-direction: column; }
  .q-opts-side { width: 100%; }
  .q-passage { font-size: 15px; }
  .btn { font-size: 13px; padding: 10px 22px; }
  .result-section { margin: 0 6px 16px; padding: 14px 10px; }
  .result-stat-card { min-width: 58px; padding: 8px 4px; }
  .stat-num { font-size: 20px; }
  .result-table { font-size: 12px; }
  .result-table th, .result-table td { padding: 6px 8px; }
  .res-btn { font-size: 13px; padding: 10px 20px; }
}
</style>
