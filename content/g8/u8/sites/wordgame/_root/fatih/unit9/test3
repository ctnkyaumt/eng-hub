<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #e8edf2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 8px 80px;
}

.color-bar, .color-bar-bottom, .page { width: calc(100% - 20px); max-width: 1900px; }

.color-bar, .color-bar-bottom { display: flex; height: 13px; overflow: hidden; }
.color-bar { border-radius: 8px 8px 0 0; }
.color-bar-bottom { border-radius: 0 0 8px 8px; margin-top: -1px; }
.cb1 { background: #EF9A9A; flex: 1; }
.cb2 { background: #A5D6A7; flex: 1; }
.cb3 { background: #90CAF9; flex: 1; }
.cb4 { background: #FFF176; flex: 1; }

.page {
  background: #fff;
  border-radius: 0 0 18px 18px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.13);
  overflow: hidden;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 14px;
  border-bottom: 2px solid #f0f0f0;
  gap: 10px;
}
.nav-links {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 700; color: #aaa; flex-shrink: 0;
}
.nav-links a { color: #1565C0; text-decoration: none; font-weight: 700; transition: color 0.15s; }
.nav-links a:hover { color: #E53935; }
.nav-sep { color: #ccc; font-size: 15px; }
.page-title { text-align: center; flex: 1; }
.page-title .unit-label { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase; }
.page-title h1 { font-size: 22px; font-weight: 900; color: #1a237e; }
.canbay-btn {
  font-size: 13px; font-weight: 800; color: #E53935;
  text-decoration: none; background: #fff;
  border: 2px solid #E53935; border-radius: 8px;
  padding: 6px 14px; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.canbay-btn:hover { background: #FFEBEE; transform: translateY(-1px); }
.fullscreen-btn {
  font-size: 13px; font-weight: 800; color: #1565C0;
  background: #fff; border: 2px solid #1565C0;
  border-radius: 8px; padding: 6px 14px; cursor: pointer;
  font-family: inherit; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.fullscreen-btn:hover { background: #E3F2FD; transform: translateY(-1px); }

.test-header {
  background: #EF9A9A;
  color: #7f1c1c;
  text-align: center;
  padding: 18px 14px 14px;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.test-sub { font-size: 14px; font-weight: 600; opacity: 0.85; margin-top: 4px; letter-spacing: 0; text-transform: none; }

.test-q-wrap { padding: 16px 14px 8px; }
.test-q-box {
  background: #F8F9FA;
  border: 2px solid #E0E0E0;
  border-radius: 12px;
  padding: 16px 18px;
  margin-bottom: 14px;
}
.test-q-label {
  font-size: 20px; font-weight: 700; color: #1565C0;
  margin-bottom: 10px; display: flex; align-items: flex-start; gap: 8px;
}
.test-q-num {
  background: #E53935; color: #fff;
  border-radius: 50%; width: 28px; height: 28px;
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.q-img-opts { display: flex; gap: 16px; align-items: flex-start; }
.q-img-side { flex: 1; min-width: 0; }
.q-img-side img { width: 100%; max-height: calc(100vh - 440px); max-width: 420px; object-fit: contain; border-radius: 8px; display: block; }
.q-opts-side { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.q-passage { font-size:20px; line-height:1.85; color:#222; background:#EEF2FF; border-radius:10px; padding:14px 18px; border-left:5px solid #3949AB; }
.q-passage p { margin-bottom:8px; }
.q-passage p:last-child { margin-bottom:0; }

.test-opt {
  border: 2px solid #CFD8DC;
  border-radius: 10px;
  background: #fff;
  padding: 10px 14px;
  font-size: 20px;
  font-weight: 600;
  color: #333;
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  gap: 10px;
}
.test-opt:hover { border-color: #E53935; background: #FFEBEE; }
.test-opt .opt-letter {
  background: #E53935; color: #fff;
  border-radius: 6px; width: 26px; height: 26px;
  font-size: 13px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.test-opt.answered   { pointer-events: none; }
.test-opt.correct    { border-color: #4CAF50; background: #E8F5E9; color: #1B5E20; }
.test-opt.correct .opt-letter { background: #4CAF50; }
.test-opt.wrong      { border-color: #F44336; background: #FFEBEE; color: #B71C1C; }
.test-opt.wrong .opt-letter   { background: #F44336; }

.btn-row { display: flex; justify-content: center; gap: 16px; padding: 14px; }
.btn {
  border: none; border-radius: 28px;
  font-size: 15px; font-weight: 700;
  padding: 12px 36px;
  cursor: pointer; font-family: inherit; transition: all 0.2s;
