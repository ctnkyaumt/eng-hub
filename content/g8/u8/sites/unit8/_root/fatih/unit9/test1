let testSelections = {};
let testShown = {};

function buildTest() {
  const wrap = document.getElementById('testWrap');
  wrap.innerHTML = '';
  if (!TEST_QUESTIONS.length) {
    wrap.innerHTML = '<p style="text-align:center;padding:40px;color:#aaa;font-weight:700;">Sorular yakında eklenecek.</p>';
    return;
  }
  TEST_QUESTIONS.forEach((q, qi) => {
    const box = document.createElement('div');
    box.className = 'test-q-box';
    box.id = `qbox-${qi}`;

    const label = document.createElement('div');
    label.className = 'test-q-label';
    label.innerHTML = `<span class="test-q-num">${q.num}</span><span>${q.instruction}</span>`;
    box.appendChild(label);

    const imgOpts = document.createElement('div');
    imgOpts.className = 'q-img-opts';

    const imgSide = document.createElement('div');
    imgSide.className = 'q-img-side';
    imgSide.innerHTML = q.imgSide;
    imgOpts.appendChild(imgSide);

    const optsSide = document.createElement('div');
    optsSide.className = 'q-opts-side';
    if (q.question) {
      const qText = document.createElement('div');
      qText.style.cssText = 'font-size:20px;font-weight:700;color:#333;margin-bottom:4px;';
      qText.textContent = q.question;
      optsSide.appendChild(qText);
    }
    ['A','B','C','D'].forEach((letter, li) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'test-opt';
      btn.id = `topt-${qi}-${letter}`;
      btn.innerHTML = `<span class="opt-letter">${letter}</span>${q.options[li]}`;
      btn.addEventListener('click', () => revealAnswer(qi, letter));
      optsSide.appendChild(btn);
    });
    imgOpts.appendChild(optsSide);
    box.appendChild(imgOpts);

    const qBtnRow = document.createElement('div');
    qBtnRow.style.cssText = 'display:flex;align-items:center;gap:10px;margin-top:12px;';

    const showBtn = document.createElement('button');
    showBtn.type = 'button';
    showBtn.className = 'btn btn-check';
    showBtn.style.cssText = 'font-size:13px;padding:8px 22px;';
    showBtn.textContent = '👁 Show Answer';
    showBtn.addEventListener('click', () => revealAnswer(qi, null));

    const resetBtn = document.createElement('button');
    resetBtn.type = 'button';
    resetBtn.className = 'btn btn-reset';
    resetBtn.style.cssText = 'font-size:13px;padding:8px 18px;';
    resetBtn.textContent = '↺';
    resetBtn.addEventListener('click', () => resetSingleQ(qi));

    const feedbackEl = document.createElement('span');
    feedbackEl.id = `tfeedback-${qi}`;
    feedbackEl.style.cssText = 'font-size:14px;font-weight:700;';

    qBtnRow.appendChild(showBtn);
    qBtnRow.appendChild(resetBtn);
    qBtnRow.appendChild(feedbackEl);

    const timerBtn = document.createElement('button');
    timerBtn.type = 'button';
    timerBtn.className = 'btn btn-timer';
    timerBtn.style.cssText = 'font-size:13px;padding:8px 22px;margin-left:auto;';
    timerBtn.textContent = '⏱ Start Timer';
    timerBtn.id = `timer-${qi}`;
    timerBtn.addEventListener('click', () => startTimer(qi));
    qBtnRow.appendChild(timerBtn);

    if (qi < TEST_QUESTIONS.length - 1) {
      const nextBtn = document.createElement('button');
      nextBtn.type = 'button';
      nextBtn.className = 'btn btn-next';
      nextBtn.style.cssText = 'font-size:13px;padding:8px 22px;';
      nextBtn.textContent = 'Next Question ↓';
      nextBtn.addEventListener('click', () => {
        const nextBox = document.getElementById(`qbox-${qi + 1}`);
        if (nextBox) nextBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      qBtnRow.appendChild(nextBtn);
    }

    box.appendChild(qBtnRow);
    wrap.appendChild(box);
  });
}

function revealAnswer(qi, selected) {
  const q = TEST_QUESTIONS[qi];
  const fb = document.getElementById(`tfeedback-${qi}`);
  ['A','B','C','D'].forEach(l => {
    const b = document.getElementById(`topt-${qi}-${l}`);
    b.classList.remove('selected','correct','wrong','answered');
    b.classList.add('answered');
  });
  document.getElementById(`topt-${qi}-${q.ans}`).classList.add('correct');
  if (selected === null) {
    fb.style.color = '#1565C0'; fb.textContent = `✓ Answer: ${q.ans}`;
    testShown[qi] = true;
  } else if (selected === q.ans) {
    fb.style.color = '#2E7D32'; fb.textContent = '🎉 Correct!';
    delete testShown[qi];
  } else {
    document.getElementById(`topt-${qi}-${selected}`).classList.add('wrong');
    fb.style.color = '#B71C1C'; fb.textContent = `✗ The answer is ${q.ans}`;
    delete testShown[qi];
  }
  testSelections[qi] = selected;
  updateResults();
}

function resetSingleQ(qi) {
  delete testSelections[qi];
  delete testShown[qi];
  ['A','B','C','D'].forEach(l => {
    const b = document.getElementById(`topt-${qi}-${l}`);
    if (b) b.classList.remove('selected','correct','wrong','answered');
  });
  const fb = document.getElementById(`tfeedback-${qi}`);
  if (fb) fb.textContent = '';
  stopTimer(qi);
  updateResults();
}

function resetTest() {
  testSelections = {};
  testShown = {};
  TEST_QUESTIONS.forEach((_, qi) => resetSingleQ(qi));
  updateResults();
}

// ── Timer ──
const timerIntervals = {};
function startTimer(qi) {
  const btn = document.getElementById(`timer-${qi}`);
  if (!btn) return;
  if (timerIntervals[qi]) { stopTimer(qi); return; }
  let remaining = 90;
  updateTimerBtn(btn, remaining);
  timerIntervals[qi] = setInterval(() => {
    remaining--;
    updateTimerBtn(btn, remaining);
    if (remaining <= 10) btn.className = 'btn btn-timer danger';
    else if (remaining <= 30) btn.className = 'btn btn-timer warning';
    if (remaining <= 0) {
      clearInterval(timerIntervals[qi]); delete timerIntervals[qi];
      btn.className = 'btn btn-timer danger'; btn.textContent = '⏱ 0:00';
      playBeep();
    }
  }, 1000);
}
function stopTimer(qi) {
  if (timerIntervals[qi]) { clearInterval(timerIntervals[qi]); delete timerIntervals[qi]; }
  const btn = document.getElementById(`timer-${qi}`);
  if (btn) { btn.className = 'btn btn-timer'; btn.textContent = '⏱ Start Timer'; }
}
function updateTimerBtn(btn, seconds) {
  const m = Math.floor(seconds / 60), s = seconds % 60;
  btn.textContent = `⏱ ${m}:${s.toString().padStart(2,'0')}`;
}
function playBeep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [0, 0.3, 0.6].forEach(delay => {
      const osc = ctx.createOscillator(), gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine'; osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.6, ctx.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + 0.4);
      osc.start(ctx.currentTime + delay); osc.stop(ctx.currentTime + delay + 0.4);
    });
  } catch(e) {}
}

// ── Sonuç Sistemi ──
function updateResults() {
  const total = TEST_QUESTIONS.length;
  let correct = 0, wrong = 0, blank = 0;
  const tbody = document.getElementById('resultTbody');
  tbody.innerHTML = '';
  TEST_QUESTIONS.forEach((q, qi) => {
    const selected = testSelections[qi];
    const shown = testShown[qi];
    const tr = document.createElement('tr');
    let statusBadge, rowClass, selectedText, correctText;
    if (selected === undefined && !shown) {
      blank++; rowClass = 'row-blank'; selectedText = '—'; correctText = '—';
      statusBadge = '<span class="badge badge-blank">Boş</span>';
    } else if (shown && selected === undefined) {
      blank++; rowClass = 'row-shown'; selectedText = '—'; correctText = q.ans;
      statusBadge = '<span class="badge badge-shown">Gösterildi</span>';
    } else if (selected === q.ans) {
      correct++; rowClass = 'row-correct'; selectedText = selected; correctText = q.ans;
      statusBadge = '<span class="badge badge-correct">✓ Doğru</span>';
    } else {
      wrong++; rowClass = 'row-wrong'; selectedText = selected || '—'; correctText = q.ans;
      statusBadge = '<span class="badge badge-wrong">✗ Yanlış</span>';
    }
    tr.className = rowClass;
    tr.innerHTML = `<td><strong>${q.num}</strong></td><td>${selectedText}</td><td>${correctText}</td><td>${statusBadge}</td>`;
    tbody.appendChild(tr);
  });
  const answered = correct + wrong;
  const pct = answered > 0 ? Math.round((correct / total) * 100) : 0;
  document.getElementById('statTotal').textContent   = total;
  document.getElementById('statCorrect').textContent = correct;
  document.getElementById('statWrong').textContent   = wrong;
  document.getElementById('statBlank').textContent   = blank;
  document.getElementById('statScore').textContent   = answered > 0 ? `%${pct}` : '—';
  document.getElementById('resultProgressBar').style.width = pct + '%';
}

function downloadResult() {
  if (typeof html2canvas === 'undefined') { alert('html2canvas yüklenmedi.'); return; }
  const section = document.getElementById('resultSection');
  const savedZoom = document.querySelector('.page').style.zoom;
  document.querySelector('.page').style.zoom = 1;
  document.getElementById('drawCanvas').style.display = 'none';
  html2canvas(section, { scale: 2, useCORS: true, backgroundColor: '#ffffff' }).then(canvas => {
    document.querySelector('.page').style.zoom = savedZoom;
    document.getElementById('drawCanvas').style.display = '';
    const link = document.createElement('a');
    link.download = 'test-result.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  });
}

function shareWhatsApp() {
  const testName = document.title.split(' | ')[0];
  const correct = parseInt(document.getElementById('statCorrect').textContent) || 0;
  const wrong   = parseInt(document.getElementById('statWrong').textContent)   || 0;
  const blank   = parseInt(document.getElementById('statBlank').textContent)   || 0;
  const score   = document.getElementById('statScore').textContent;
  const text = testName + ' Sonucum\n\u2705 Correct: ' + correct + '\n\u274C Wrong: ' + wrong + '\n\u26AA Blank: ' + blank + '\n\uD83D\uDCCA Score: ' + score;
  if (typeof html2canvas !== 'undefined' && navigator.canShare) {
    const section = document.getElementById('resultSection');
    const savedZoom = document.querySelector('.page').style.zoom;
    document.querySelector('.page').style.zoom = 1;
    document.getElementById('drawCanvas').style.display = 'none';
    html2canvas(section, { scale: 2, useCORS: true, backgroundColor: '#ffffff' }).then(canvas => {
      document.querySelector('.page').style.zoom = savedZoom;
      document.getElementById('drawCanvas').style.display = '';
      canvas.toBlob(blob => {
        const file = new File([blob], 'test-result.png', { type: 'image/png' });
        if (navigator.canShare({ files: [file] })) {
          navigator.share({ files: [file], title: testName, text: text }).catch(() => {});
        } else { fallbackWhatsApp(text); }
      });
    });
  } else { fallbackWhatsApp(text); }
}

function fallbackWhatsApp(text) {
  window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
}

