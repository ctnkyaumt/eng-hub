}
.test-q-label {
  font-size: 20px; font-weight: 700; color: #1565C0;
  margin-bottom: 10px; display: flex; align-items: flex-start; gap: 8px;
}
.test-q-num {
  background: #E53935; color: #fff;
  border-radius: 50%; width: 28px; height: 28px;
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.q-img-opts { display: flex; gap: 16px; align-items: flex-start; }
.q-img-side { flex: 1; min-width: 0; }
.q-img-side img { width: 100%; max-height: calc(100vh - 440px); max-width: 420px; object-fit: contain; border-radius: 8px; display: block; }
.q-opts-side { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.q-passage { font-size:20px; line-height:1.85; color:#222; background:#EEF2FF; border-radius:10px; padding:14px 18px; border-left:5px solid #3949AB; }
.q-passage p { margin-bottom:8px; }
