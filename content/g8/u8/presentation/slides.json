   "teachingSource": {
    "type": "grammar",
    "title": "Asking for Help",
    "titleTr": "Yardım isteme ve teklif etme",
    "rule": "Kibar rica için *Could you ...?* ve *Would you mind + V-ing?*, yardım teklifi için *Shall I ...?* kullanılır.",
    "chips": [
     "Could you ...?",
     "Would you mind ...?",
     "Shall I ...?",
     "Can you give me a hand?"
    ],
    "examples": [
     {
      "en": "*Could you* help me with the laundry?",
      "tr": "Çamaşırlarda bana yardım eder misin?",
      "img": "/app/img/words/laundry.jpg",
      "trEm": [
       "yardım eder misin"
      ]
     },
