<script>
const TEST_QUESTIONS = [
  {
    num: 1,
    instruction: 'Read the conversation and answer the question.',
    imgSide: `<img src="img/test1-soru1.png" alt="Q1">`,
    question: 'Which of the following questions does the host NOT ask Jane?',
    options: [
      'Why do you enjoy it?',
      'How often do you do it?',
      'Where do you usually fly?',
      'What equipment do you use?'
    ],
    ans: 'C'
  },
  {
    num: 2,
    instruction: 'Read the table and answer the question.',
    imgSide: `<img src="img/test1-soru2.png" alt="Q2">`,
    question: 'Which of the following is NOT correct according to the table?',
    options: [
      'Ece goes cycling.',
      'Ege tries hang gliding.',
      'Mert prefers safe sports.',
      'Ali is an adrenaline seeker.'
    ],
    ans: 'C'
  },
  {
    num: 3,
    instruction: 'Read the situation and answer the question.',
    imgSide: `<img src="img/test1-soru3.png" alt="Q3">`,
    question: 'What was your comment?',
    options: [
      'This is one of your best shots!',
      "I've seen many photos like this before.",
      'You look a bit nervous here.',
      'You posted a similar photo last week.'
    ],
    ans: 'A'
  },
  {
    num: 4,
    instruction: 'Read the text and answer the question.',
    imgSide: `<img src="img/test1-ssoru4.png" alt="Q4">`,
    question: 'Which of the following is NOT correct according to the text?',
    options: [
      'The tour takes place in summer.',
      'You can join it early in the morning.',
      'You get breakfast before the tour.',
      'The tour finishes in the evening.'
    ],
    ans: 'D'
  },
  {
    num: 5,
    instruction: 'Read the comments and answer the question.',
    imgSide: `<img src="img/test1-soru5.png" alt="Q5">`,
    question: 'Who mentions something important for safety?',
    options: [
      'Emily',
      'Ryan',
      'Liam',
      'Sophie'
    ],
    ans: 'D'
  },
  {
