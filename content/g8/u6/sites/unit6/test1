<script>
// ── Drawing ──
const canvas = document.getElementById('drawCanvas');
const ctx = canvas.getContext('2d');
let drawing = false;
let currentTool = null;
let hlSnapshot = null;
let hlPath     = [];

function resizeCanvas() {
  const tmp = canvas.toDataURL();
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;
  const img = new Image();
  img.onload = () => ctx.drawImage(img, 0, 0);
  img.src = tmp;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

function setTool(tool) {
  if (currentTool === tool) { endDrawing(); return; }
  currentTool = tool;
  canvas.style.pointerEvents = 'auto';
  ['btnPen','btnHighlight','btnEraser'].forEach(id => {
    document.getElementById(id).classList.remove('active','active-highlight');
  });
  if (tool === 'pen')       document.getElementById('btnPen').classList.add('active');
  if (tool === 'highlight') document.getElementById('btnHighlight').classList.add('active-highlight');
  if (tool === 'eraser')    document.getElementById('btnEraser').classList.add('active');
  canvas.style.cursor = tool === 'eraser' ? 'cell' : 'crosshair';
}
function endDrawing() {
  currentTool = null;
  canvas.style.pointerEvents = 'none';
  canvas.style.cursor = 'default';
  ['btnPen','btnHighlight','btnEraser'].forEach(id => {
    document.getElementById(id).classList.remove('active','active-highlight');
  });
}
function clearCanvas() { ctx.clearRect(0, 0, canvas.width, canvas.height); }
function getPos(e) {
  const t = e.touches ? e.touches[0] : e;
  return { x: t.clientX, y: t.clientY };
}
canvas.addEventListener('mousedown',  startDraw);
canvas.addEventListener('mousemove',  moveDraw);
canvas.addEventListener('mouseup',    stopDraw);
canvas.addEventListener('mouseleave', stopDraw);
canvas.addEventListener('touchstart', e => { e.preventDefault(); startDraw(e); }, { passive: false });
canvas.addEventListener('touchmove',  e => { e.preventDefault(); moveDraw(e);  }, { passive: false });
canvas.addEventListener('touchend',   stopDraw);
function startDraw(e) {
  if (!currentTool) return;
  drawing = true;
  const { x, y } = getPos(e);
  if (currentTool === 'highlight') {
    hlSnapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);
    hlPath = [{ x, y }];
  } else { ctx.beginPath(); ctx.moveTo(x, y); }
}
function moveDraw(e) {
  if (!drawing || !currentTool) return;
  const { x, y } = getPos(e);
  if (currentTool === 'pen') {
    ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
    ctx.strokeStyle = '#E53935'; ctx.lineWidth = 3;
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.lineTo(x, y); ctx.stroke(); ctx.beginPath(); ctx.moveTo(x, y);
  } else if (currentTool === 'highlight') {
    hlPath.push({ x, y });
    ctx.putImageData(hlSnapshot, 0, 0);
    ctx.save();
    ctx.globalAlpha = 0.28; ctx.globalCompositeOperation = 'source-over';
    ctx.strokeStyle = '#FFD600'; ctx.lineWidth = 22;
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); ctx.moveTo(hlPath[0].x, hlPath[0].y);
    for (let i = 1; i < hlPath.length; i++) ctx.lineTo(hlPath[i].x, hlPath[i].y);
    ctx.stroke(); ctx.restore();
  } else if (currentTool === 'eraser') {
    ctx.globalCompositeOperation = 'destination-out'; ctx.globalAlpha = 1;
    ctx.lineWidth = 28; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.lineTo(x, y); ctx.stroke(); ctx.beginPath(); ctx.moveTo(x, y);
  }
}
function stopDraw() {
  hlSnapshot = null; hlPath = []; drawing = false;
  ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
}

// ── Zoom ──
let currentZoom = 1.0;
const ZOOM_STEP = 0.1, ZOOM_MIN = 0.5, ZOOM_MAX = 2.0;
function applyZoom() {
  document.querySelector('.page').style.zoom = currentZoom;
  document.getElementById('zoomLabel').textContent = Math.round(currentZoom * 100) + '%';
}
function zoomIn()  { if (currentZoom < ZOOM_MAX) { currentZoom = Math.round((currentZoom + ZOOM_STEP) * 10) / 10; applyZoom(); } }
function zoomOut() { if (currentZoom > ZOOM_MIN) { currentZoom = Math.round((currentZoom - ZOOM_STEP) * 10) / 10; applyZoom(); } }

// ── Saat ──
function updateClock() {
  const now = new Date();
  document.getElementById('barClock').textContent =
    now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
}
updateClock();
setInterval(updateClock, 1000);
</script>
