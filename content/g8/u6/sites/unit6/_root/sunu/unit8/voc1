<script>
/* ════════════════ Part 1: Image Matching ════════════════ */
const MATCH_ITEMS = [
  { img: 'vocabulary/cook-the-meal.jpg',        word: 'cook the meal' },
  { img: 'vocabulary/set-the-table.jpg',         word: 'set the table' },
  { img: 'vocabulary/wash-the-dishes.jpg',       word: 'wash the dishes' },
  { img: 'vocabulary/empty-the-dishwasher.jpg',  word: 'empty the dishwasher' },
  { img: 'vocabulary/do-the-ironing.jpg',        word: 'do the ironing' },
  { img: 'vocabulary/dust-the-furniture.jpg',    word: 'dust the furniture' },
  { img: 'vocabulary/water-the-flowers.jpg',     word: 'water the flowers' },
  { img: 'vocabulary/sweep-the-leaves.jpg',      word: 'sweep the leaves' },
  { img: 'vocabulary/feed-the-cat.jpg',          word: 'feed the cat' },
  { img: 'vocabulary/do-the-shopping.jpg',       word: 'do the shopping' },
];

const WORD_BANK_WORDS = [
  'feed the cat', 'do the shopping', 'sweep the leaves', 'water the flowers',
  'dust the furniture', 'do the ironing', 'empty the dishwasher', 'wash the dishes',
  'set the table', 'cook the meal'
];

let draggedWord = null;
let selectedWord = null;
const dropAnswers = {};

// ── Touch drag support ──
let touchClone = null, touchWord = null;

function setupChipTouch(chip, word) {
  chip.addEventListener('touchstart', e => {
    e.preventDefault();
    touchWord = word;
    const touch = e.touches[0];
    touchClone = chip.cloneNode(true);
    touchClone.style.cssText = `position:fixed;z-index:99999;pointer-events:none;opacity:0.88;
      transform:scale(1.08);margin:0;
      left:${touch.clientX - chip.offsetWidth / 2}px;
      top:${touch.clientY - chip.offsetHeight / 2}px;`;
    document.body.appendChild(touchClone);
    chip.classList.add('dragging');
  }, { passive: false });

  chip.addEventListener('touchmove', e => {
    e.preventDefault();
    if (!touchClone) return;
    const touch = e.touches[0];
    touchClone.style.left = (touch.clientX - touchClone.offsetWidth / 2) + 'px';
    touchClone.style.top  = (touch.clientY - touchClone.offsetHeight / 2) + 'px';
  }, { passive: false });

  chip.addEventListener('touchend', e => {
    e.preventDefault();
    if (!touchClone || !touchWord) return;
    const touch = e.changedTouches[0];
    touchClone.style.display = 'none';
    const el = document.elementFromPoint(touch.clientX, touch.clientY);
    touchClone.remove(); touchClone = null;
    chip.classList.remove('dragging');
    const zone = el && el.closest('[id^="drop-"]');
    if (zone) placeWord(parseInt(zone.id.replace('drop-', '')), touchWord);
    touchWord = null;
  }, { passive: false });
}

function buildMatch() {
  const bank = document.getElementById('wordBank');
  WORD_BANK_WORDS.forEach(word => {
    const chip = document.createElement('div');
    chip.className = 'word-chip';
    chip.textContent = word;
    chip.draggable = true;
    chip.dataset.word = word;
    chip.addEventListener('dragstart', e => {
      draggedWord = word;
      chip.classList.add('dragging');
      e.dataTransfer.setData('text/plain', word);
    });
    chip.addEventListener('dragend', () => chip.classList.remove('dragging'));
    chip.addEventListener('click', () => {
      if (chip.classList.contains('used')) return;
      if (selectedWord === word) {
        selectedWord = null;
        chip.classList.remove('selected');
      } else {
        document.querySelectorAll('.word-chip').forEach(c => c.classList.remove('selected'));
        selectedWord = word;
        chip.classList.add('selected');
      }
    });
    setupChipTouch(chip, word);
    bank.appendChild(chip);
  });

  const grid = document.getElementById('imgGrid');
  MATCH_ITEMS.forEach((item, idx) => {
    const card = document.createElement('div');
    card.className = 'img-card';

    const img = document.createElement('img');
    img.src = item.img;
    img.alt = item.word;
    card.appendChild(img);

    const zone = document.createElement('div');
    zone.className = 'drop-zone';
    zone.id = `drop-${idx}`;
    zone.innerHTML = `<span class="drop-zone-placeholder">drop here</span>`;

    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
    zone.addEventListener('drop', e => {
      e.preventDefault();
      zone.classList.remove('drag-over');
      const word = e.dataTransfer.getData('text/plain');
      if (word) placeWord(idx, word);
    });
    zone.addEventListener('click', () => {
      if (!selectedWord) return;
      placeWord(idx, selectedWord);
    });

    card.appendChild(zone);
    grid.appendChild(card);
  });
}

function placeWord(idx, word) {
  // Remove this word from any other zone
  Object.entries(dropAnswers).forEach(([i, w]) => {
    if (w === word && parseInt(i) !== idx) {
      delete dropAnswers[parseInt(i)];
      const z = document.getElementById(`drop-${i}`);
      z.className = 'drop-zone';
      z.innerHTML = `<span class="drop-zone-placeholder">drop here</span>`;
    }
  });
  dropAnswers[idx] = word;
  const zone = document.getElementById(`drop-${idx}`);
  zone.className = 'drop-zone';
  zone.textContent = word;
  // Clear click selection
  selectedWord = null;
  document.querySelectorAll('.word-chip').forEach(c => c.classList.remove('selected'));
  updateChipUsed();
}

function updateChipUsed() {
  const usedWords = Object.values(dropAnswers);
  document.querySelectorAll('.word-chip').forEach(chip => {
    chip.classList.toggle('used', usedWords.includes(chip.dataset.word));
  });
}

function checkMatch() {
  let correct = 0;
  MATCH_ITEMS.forEach((item, idx) => {
    const zone = document.getElementById(`drop-${idx}`);
    const ans = dropAnswers[idx];
    if (!ans) { zone.className = 'drop-zone'; return; }
    if (ans === item.word) { zone.className = 'drop-zone correct'; correct++; }
    else { zone.className = 'drop-zone wrong'; }
  });
  const result = document.getElementById('matchResult');
