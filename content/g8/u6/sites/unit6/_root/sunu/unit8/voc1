<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #e8edf2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 8px 80px;
}

.color-bar, .color-bar-bottom, .page { width: calc(100% - 20px); max-width: 1900px; }

.color-bar, .color-bar-bottom { display: flex; height: 13px; overflow: hidden; }
.color-bar { border-radius: 8px 8px 0 0; }
.color-bar-bottom { border-radius: 0 0 8px 8px; margin-top: -1px; }
.cb1 { background: #EF9A9A; flex: 1; }
.cb2 { background: #A5D6A7; flex: 1; }
.cb3 { background: #90CAF9; flex: 1; }
.cb4 { background: #FFF176; flex: 1; }

.page {
  background: #fff;
  border-radius: 0 0 18px 18px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.13);
  overflow: hidden;
}

/* ── Header ── */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 14px;
  border-bottom: 2px solid #f0f0f0;
  gap: 10px;
}
.nav-links {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: 700; color: #aaa; flex-shrink: 0;
}
.nav-links a { color: #1565C0; text-decoration: none; font-weight: 700; transition: color 0.15s; }
.nav-links a:hover { color: #E65100; }
.nav-sep { color: #ccc; font-size: 15px; }
.page-title { text-align: center; flex: 1; }
.page-title .unit-label { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase; }
.page-title h1 { font-size: 22px; font-weight: 900; color: #1a237e; }
.canbay-btn {
  font-size: 13px; font-weight: 800; color: #E53935;
  text-decoration: none; background: #fff; border: 2px solid #E53935;
  border-radius: 8px; padding: 6px 14px; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.canbay-btn:hover { background: #FFEBEE; transform: translateY(-1px); }
.fullscreen-btn {
  font-size: 13px; font-weight: 800; color: #1565C0;
  background: #fff; border: 2px solid #1565C0;
  border-radius: 8px; padding: 6px 14px; cursor: pointer;
  font-family: inherit; transition: all 0.18s;
  white-space: nowrap; flex-shrink: 0;
}
.fullscreen-btn:hover { background: #E3F2FD; transform: translateY(-1px); }

/* ── Section headers ── */
.section-header {
  text-align: center;
  padding: 18px 14px 14px;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.section-header.sh-teal   { background: #B2DFDB; color: #004D40; }
.section-header.sh-orange { background: #FFCC80; color: #E65100; }
.section-sub {
  font-size: 14px; font-weight: 600; opacity: 0.85;
  margin-top: 4px; letter-spacing: 0; text-transform: none;
}

/* ── Word bank ── */
.word-bank-wrap {
  padding: 14px 16px 10px;
  border-bottom: 1px solid #f0f0f0;
}
.word-bank-label {
  font-size: 13px; font-weight: 700; color: #555;
  margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;
}
.word-bank { display: flex; flex-wrap: wrap; gap: 8px; }
.word-chip {
  background: #E3F2FD;
  border: 2px solid #90CAF9;
  border-radius: 20px;
  padding: 6px 16px;
  font-size: 15px;
  font-weight: 700;
  color: #1565C0;
  cursor: grab;
  -webkit-user-select: none;
  user-select: none;
  transition: all 0.15s;
  white-space: nowrap;
}
.word-chip:hover { background: #BBDEFB; border-color: #42A5F5; transform: translateY(-2px); }
.word-chip.dragging { opacity: 0.5; }
.word-chip.selected { background: #1565C0; color: #fff; border-color: #1565C0; transform: translateY(-2px); cursor: pointer; }
.word-chip.used { opacity: 0.3; pointer-events: none; background: #F5F5F5; border-color: #E0E0E0; color: #999; }

/* ── Image match grid ── */
.img-match-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  padding: 14px 16px 20px;
}
.img-card {
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #E0E0E0;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  transition: border-color 0.2s;
}
.img-card img {
  width: 100%;
  height: 140px;
  object-fit: cover;
  display: block;
}
.drop-zone {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 6px;
  border-top: 2px dashed #B0BEC5;
  font-size: 19px;
  font-weight: 700;
  color: #555;
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
}
.drop-zone.drag-over { background: #E3F2FD; border-color: #42A5F5; color: #1565C0; }
.drop-zone.correct   { background: #E8F5E9; border-color: #4CAF50; color: #2E7D32; border-style: solid; }
.drop-zone.wrong     { background: #FFEBEE; border-color: #F44336; color: #C62828; border-style: solid; }
.drop-zone-placeholder { color: #BDBDBD; font-style: italic; font-weight: 500; font-size: 12px; }

.match-result {
  text-align: center;
  padding: 12px;
  font-size: 18px;
  font-weight: 700;
  display: none;
}

/* ── Match buttons ── */
.btn-match-row { display: flex; justify-content: center; gap: 12px; padding: 4px 16px 20px; }
.btn-match-check {
  background: #2E7D32; color: #fff; border: none; border-radius: 20px;
  font-size: 14px; font-weight: 700; padding: 10px 28px;
  cursor: pointer; font-family: inherit; transition: all 0.18s;
}
.btn-match-check:hover { background: #1B5E20; transform: translateY(-2px); }
.btn-match-reset {
  background: #607D8B; color: #fff; border: none; border-radius: 20px;
  font-size: 14px; font-weight: 700; padding: 10px 24px;
  cursor: pointer; font-family: inherit; transition: all 0.18s;
}
.btn-match-reset:hover { background: #455A64; }

/* ── Part 2: Question boxes ── */
.test-q-wrap { padding: 16px 14px 8px; }
.test-q-box {
  background: #F8F9FA;
  border: 2px solid #E0E0E0;
  border-radius: 12px;
  padding: 16px 18px;
  margin-bottom: 14px;
}
.test-q-label {
  font-size: 20px; font-weight: 700; color: #E65100;
  margin-bottom: 10px; display: flex; align-items: flex-start; gap: 8px;
}
.test-q-num {
  background: #E65100; color: #fff; border-radius: 50%;
  width: 28px; height: 28px; font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.q-img-opts { display: flex; gap: 16px; align-items: flex-start; }
.q-img-side { flex: 1; min-width: 0; }
.q-opts-side { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }

.test-content-box {
  background: #fff;
  border: 1.5px dashed #B0BEC5;
  border-radius: 8px;
  padding: 14px 16px;
  font-size: 20px;
  line-height: 1.85;
  color: #333;
}

.test-options { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.test-opt {
  border: 2px solid #CFD8DC; border-radius: 10px;
  background: #fff; padding: 10px 14px;
  font-size: 20px; font-weight: 600; color: #333;
  cursor: pointer; font-family: inherit; text-align: left;
  transition: all 0.15s; display: flex; align-items: center; gap: 10px;
}
.test-opt:hover { border-color: #E65100; background: #FFF3E0; }
.test-opt .opt-letter {
  background: #E65100; color: #fff; border-radius: 6px;
  width: 26px; height: 26px; font-size: 13px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.test-opt.correct   { border-color: #4CAF50; background: #E8F5E9; color: #1B5E20; }
.test-opt.correct .opt-letter { background: #4CAF50; }
.test-opt.wrong     { border-color: #F44336; background: #FFEBEE; color: #B71C1C; }
.test-opt.wrong .opt-letter   { background: #F44336; }
.test-opt.answered  { pointer-events: none; }

/* ── Buttons ── */
.btn-row { display: flex; justify-content: center; gap: 16px; padding: 14px; }
.btn {
  border: none; border-radius: 28px;
  font-size: 15px; font-weight: 700; padding: 12px 36px;
  cursor: pointer; font-family: inherit; transition: all 0.2s;
}
.btn-check { background: #E65100; color: #fff; }
.btn-check:hover { background: #BF360C; transform: translateY(-2px); }
.btn-reset { background: #607D8B; color: #fff; }
.btn-reset:hover { background: #455A64; }
.btn-next  { background: #1565C0; color: #fff; }
.btn-next:hover { background: #0D47A1; transform: translateY(-2px); }
.btn-timer { background: #00796B; color: #fff; min-width: 130px; }
.btn-timer:hover { background: #004D40; transform: translateY(-2px); }
.btn-timer.warning { background: #E65100; }
.btn-timer.danger  { background: #B71C1C; }

/* ── Copyright ── */
.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #9E9E9E; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

/* ── Fixed bottom bar ── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9999;
  background: #fff; border-top: 3px solid #7B1C1C;
