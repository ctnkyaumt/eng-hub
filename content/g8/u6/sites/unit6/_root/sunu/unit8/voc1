}
.bar-btn-fs { background: #7B1C1C; color: #fff; border: 2px solid #7B1C1C; }
.bar-btn-fs:hover { background: #5D1010; border-color: #5D1010; }
.bar-btn-zoom { background: transparent; color: #7B1C1C; border: 2px solid rgba(123,28,28,0.4); font-size: 18px; padding: 6px 16px; }
.bar-btn-zoom:hover { background: rgba(123,28,28,0.08); border-color: #7B1C1C; }
.bar-zoom-label { color: #555; font-size: 13px; font-weight: 700; min-width: 40px; text-align: center; }
.bar-divider { width: 1px; height: 32px; background: rgba(123,28,28,0.2); flex-shrink: 0; }
.bar-btn-draw { background: transparent; color: #333; border: 2px solid rgba(0,0,0,0.2); font-size: 13px; padding: 7px 14px; gap: 5px; display: flex; align-items: center; }
.bar-btn-draw:hover { background: rgba(0,0,0,0.06); border-color: #555; }
.bar-btn-draw.active { background: #7B1C1C; color: #fff; border-color: #7B1C1C; }
.bar-btn-draw.active-highlight { background: #FFF176; color: #333; border-color: #e6c800; }
.bar-btn-clear { background: transparent; color: #C62828; border: 2px solid rgba(198,40,40,0.35); font-size: 13px; padding: 7px 14px; }
.bar-btn-clear:hover { background: rgba(198,40,40,0.08); border-color: #C62828; }
.bar-btn-end { background: #7B1C1C; color: #fff; border: 2px solid #7B1C1C; font-size: 13px; padding: 7px 14px; }
.bar-btn-end:hover { background: #5D1010; border-color: #5D1010; }
.bar-logo { height: 32px; opacity: 0.7; flex-shrink: 0; }
.bar-btn-home { background: transparent; color: #7B1C1C; border: 2px solid rgba(123,28,28,0.4); border-radius: 8px; font-size: 20px; padding: 5px 12px; text-decoration: none; transition: all 0.18s; line-height: 1; }
.bar-btn-home:hover { background: rgba(123,28,28,0.08); border-color: #7B1C1C; }
.bar-clock { margin-left: auto; font-size: 18px; font-weight: 800; color: #7B1C1C; letter-spacing: 1px; flex-shrink: 0; }
#drawCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9998; pointer-events: none; cursor: crosshair; }
@media (max-width: 1024px) { .bottom-bar { display: none; } body { padding-bottom: 20px; } }

/* ── Mobile ── */
@media (max-width: 900px) {
  .img-match-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 700px) {
  body { padding: 8px 6px 20px; }
  .color-bar, .color-bar-bottom, .page { width: calc(100% - 12px); }
  .page-header { flex-wrap: wrap; padding: 10px 12px 8px; gap: 6px; }
  .nav-links { font-size: 11px; order: 1; flex: 1 1 100%; }
  .page-title { order: 2; flex: 1 1 auto; }
  .page-title h1 { font-size: 16px; }
  .canbay-btn { font-size: 11px; padding: 5px 10px; order: 3; }
  .section-header { font-size: 16px; padding: 14px 10px 10px; }
  .img-match-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 10px 10px 16px; }
  .test-q-wrap { padding: 10px 10px 4px; }
  .q-img-opts { flex-direction: column; }
  .q-opts-side { width: 100%; }
  .test-opt { font-size: 14px; }
  .btn { font-size: 13px; padding: 10px 22px; }
  .btn-next-q { display: none !important; }
}
