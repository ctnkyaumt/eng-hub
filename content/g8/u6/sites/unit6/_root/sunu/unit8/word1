    document.documentElement.requestFullscreen().catch(() => {});
    document.getElementById('fsBtn').textContent = '✕ Tam Ekrandan Çık';
    document.getElementById('barFsBtn').textContent = '✕ Tam Ekrandan Çık';
  } else {
    document.exitFullscreen();
    document.getElementById('fsBtn').textContent = '⛶ Tam Ekran';
    document.getElementById('barFsBtn').textContent = '⛶ Tam Ekran';
