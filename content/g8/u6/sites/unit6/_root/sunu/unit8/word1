  { num:9,  word:'responsibility',      options:['zorunluluk','sorumluluk','gereklilik','önem'],                                         ans:'B' },
  { num:10, word:'member',              options:['üye','herkes','dağınıklık','görev'],                                                   ans:'A' },
  { num:11, word:'mess',                options:['görev','dağınıklık','temizlik','düzenlilik'],                                          ans:'B' },
  { num:12, word:'tidy',                options:['dağınık','kirli','önemli','düzenli'],                                                  ans:'D' },
  { num:13, word:'duty',                options:['sorumluluk','zorunluluk','görev','çöp'],                                               ans:'C' },
  { num:14, word:'clean',               options:['hazırlamak','paylaşmak','yardım etmek','temizlemek'],                                  ans:'D' },
  { num:15, word:'complain',            options:['şikayet etmek','temizlemek','hazırlamak','paylaşmak'],                                 ans:'A' },
  { num:16, word:'responsible for…',   options:['-den sorumlu olmak','şikayet etmek','hazırlamak','meşgul olmak'],                      ans:'A' },
  { num:17, word:'garbage',             options:['ev işi','temizlik','çöp','meşgul'],                                                    ans:'C' },
  { num:18, word:'clothes',             options:['giysiler','şikayet','yaşça büyük','temiz'],                                            ans:'A' },
  { num:19, word:'elder',               options:['temiz','yaşça büyük','giysiler','ev işi'],                                             ans:'B' },
  { num:20, word:'complaint',           options:['kıyafet','hazırlık','şikayet','temizlik'],                                             ans:'C' },
  { num:21, word:'annoy',               options:['kızdırmak','paylaşmak','yıkamak','hazırlamak'],                                        ans:'A' },
  { num:22, word:'prepare',             options:['yıkamak','paylaşmak','hazırlamak','yardım etmek'],                                     ans:'C' },
  { num:23, word:'respect',             options:['saygı duymak','hazırlamak','kızdırmak','paylaşmak'],                                   ans:'A' },
  { num:24, word:'share',               options:['hazırlamak','paylaşmak','yıkamak','kızdırmak'],                                        ans:'B' },
  { num:25, word:'take care of',        options:['kızdırmak','yıkamak','hazırlamak','ile ilgilenmek'],                                   ans:'D' },
  { num:26, word:'wash',                options:['hazırlamak','kızdırmak','yıkamak','paylaşmak'],                                        ans:'C' },
  { num:27, word:'housework',           options:['sorumluluk','ev işi','zorunluluk','ödev'],                                             ans:'B' },
  { num:28, word:'rude',                options:['kibar','saygılı','yardımsever','kaba'],                                                ans:'D' },
  { num:29, word:'right',               options:['hak, doğru','görev','saygı','ödev'],                                                  ans:'A' },
  { num:30, word:'cook the meal',       options:['masayı kurmak','yemek pişirmek','paylaşmak','ütü yapmak'],                             ans:'B' },
  { num:31, word:'do the errands',      options:['ütü yapmak','çamaşır yıkamak','işleri halletmek','bulaşıkları yıkamak'],              ans:'C' },
  { num:32, word:'do the ironing',      options:['masayı kurmak','ütü yapmak','çamaşır yıkamak','çöpü atmak'],                          ans:'B' },
  { num:33, word:'do the laundry',      options:['çamaşır yıkamak','çöpü atmak','masayı kurmak','bulaşıkları yıkamak'],                 ans:'A' },
  { num:34, word:'do the shopping',     options:['yatağı toplamak','ütü yapmak','çamaşır yıkamak','alışveriş yapmak'],                  ans:'D' },
  { num:35, word:'dry the dishes',      options:['tabakları kurulamak','yatağı toplamak','ütü yapmak','çiçekleri sulamak'],              ans:'A' },
  { num:36, word:'dust the furniture',  options:['mobilyaların tozunu almak','çamaşır yıkamak','yatağı toplamak','alışveriş yapmak'],   ans:'A' },
  { num:37, word:'empty the dishwasher',options:['çamaşır yıkamak','çiçekleri sulamak','alışveriş yapmak','bulaşık makinesini boşaltmak'], ans:'D' },
  { num:38, word:'feed the cat',        options:['çiçekleri sulamak','kediyi beslemek','ütü yapmak','bulaşıkları yıkamak'],              ans:'B' },
  { num:39, word:'load the dishwasher', options:['alışveriş yapmak','çiçekleri sulamak','çamaşır yıkamak','bulaşık makinesini doldurmak'], ans:'D' },
  { num:40, word:'make the bed',        options:['yatağı toplamak','ütü yapmak','çiçekleri sulamak','çamaşır yıkamak'],                 ans:'A' },
  { num:41, word:'mop the floor',       options:['çamaşır yıkamak','alışveriş yapmak','yeri paspaslamak','bulaşıkları yıkamak'],        ans:'C' },
