  { num:45, word:'tidy up the room',    options:['alışveriş yapmak','ütü yapmak','odayı toplamak','çiçekleri sulamak'],                 ans:'C' },
  { num:46, word:'vacuum the floor',    options:['yeri süpürmek','çamaşır yıkamak','ütü yapmak','bulaşıkları yıkamak'],                 ans:'A' },
  { num:47, word:'walk the dog',        options:['köpeği yürüyüşe çıkarmak','alışveriş yapmak','çiçekleri sulamak','çamaşır yıkamak'], ans:'A' },
  { num:48, word:'wash the dishes',     options:['alışveriş yapmak','çiçekleri sulamak','ütü yapmak','bulaşıkları yıkamak'],            ans:'D' },
  { num:49, word:'water the plants',    options:['çamaşır yıkamak','ütü yapmak','alışveriş yapmak','çiçekleri sulamak'],               ans:'D' },
  { num:50, word:'iron the clothes',    options:['giysileri ütülemek','çiçekleri sulamak','alışveriş yapmak','çamaşır yıkamak'],        ans:'A' },
];

const LETTERS = ['A','B','C','D'];

function buildTest() {
  const tbody = document.getElementById('tableBody');
  tbody.innerHTML = '';

  WORDS.forEach((q, qi) => {
    const tr = document.createElement('tr');

    const tdNum = document.createElement('td');
    tdNum.className = 'td-num';
    tdNum.textContent = q.num;
    tr.appendChild(tdNum);

    const tdWord = document.createElement('td');
    tdWord.className = 'td-word';
    tdWord.textContent = q.word;
    tr.appendChild(tdWord);

    LETTERS.forEach((letter, li) => {
      const td = document.createElement('td');
      td.className = 'td-opt';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'q-opt';
      btn.id = `qopt-${qi}-${letter}`;
      btn.innerHTML = `<span class="opt-l">${letter}</span>${q.options[li]}`;
      btn.addEventListener('click', () => revealAnswer(qi, letter));
      td.appendChild(btn);
      tr.appendChild(td);
    });

    const tdFb = document.createElement('td');
    tdFb.className = 'td-fb';
    tdFb.id = `qfb-${qi}`;
    tr.appendChild(tdFb);

    const tdAct = document.createElement('td');
    tdAct.className = 'td-act';
    const actRow = document.createElement('div');
    actRow.className = 'act-row';

    const showBtn = document.createElement('button');
    showBtn.type = 'button';
    showBtn.className = 'btn-show-sm';
    showBtn.textContent = 'Show';
    showBtn.addEventListener('click', () => revealAnswer(qi, null));
    actRow.appendChild(showBtn);

    const resetBtn = document.createElement('button');
    resetBtn.type = 'button';
    resetBtn.className = 'btn-reset-sm';
    resetBtn.textContent = '↺';
    resetBtn.addEventListener('click', () => resetSingle(qi));
    actRow.appendChild(resetBtn);

    tdAct.appendChild(actRow);
    tr.appendChild(tdAct);
    tbody.appendChild(tr);
  });
}

function revealAnswer(qi, selected) {
  const q = WORDS[qi];
  const fb = document.getElementById(`qfb-${qi}`);
  LETTERS.forEach(l => {
    const b = document.getElementById(`qopt-${qi}-${l}`);
    b.classList.remove('correct','wrong','answered');
    b.classList.add('answered');
  });
  document.getElementById(`qopt-${qi}-${q.ans}`).classList.add('correct');
  if (selected === null) {
    fb.style.color = '#1565C0'; fb.textContent = q.ans;
  } else if (selected === q.ans) {
    fb.style.color = '#2E7D32'; fb.textContent = '🎉';
  } else {
    document.getElementById(`qopt-${qi}-${selected}`).classList.add('wrong');
    fb.style.color = '#B71C1C'; fb.textContent = `✗${q.ans}`;
  }
}

function resetSingle(qi) {
  LETTERS.forEach(l => {
    const b = document.getElementById(`qopt-${qi}-${l}`);
    if (b) b.classList.remove('correct','wrong','answered');
  });
  const fb = document.getElementById(`qfb-${qi}`);
  if (fb) fb.textContent = '';
}

function resetAll() {
  WORDS.forEach((_, qi) => resetSingle(qi));
}

buildTest();

