   "titleTr": "Telefonda konuşma kalıpları",
   "rule": "Telefonda kibar kalıplar kullanırız: *Could I speak to ...?*, *Hold on, please.*, *Can I take a message?*",
   "chips": [
    "Could I speak to ...?",
    "Hold on, please.",
    "Can I take a message?",
    "Speaking."
   ],
   "examples": [
    {
     "en": "*Could I speak to* Mr Yılmaz, please?",
     "tr": "Bay Yılmaz ile görüşebilir miyim, lütfen?"
    },
    {
     "en": "*Hold on*, please. I'll put you through.",
     "tr": "Lütfen bekleyin. Sizi bağlıyorum."
    },
    {
     "en": "*Can I take a message*?",
     "tr": "Mesajınızı alabilir miyim?"
    },
    {
     "en": "Sorry, she *isn't available* right now.",
     "tr": "Üzgünüm, şu anda müsait değil."
    }
   ]
  },
