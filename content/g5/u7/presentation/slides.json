  {
   "type": "compare",
   "title": "Expressing Ability — can / can't",
   "titleTr": "Yetenekleri ifade etme",
   "rule": "*can* (-ebilmek) yapabildiklerimizi, *can't* yapamadıklarımızı anlatır. Soruda *can* özneden önce gelir.",
   "columns": [
    {
     "title": "can ✅",
     "tone": "good",
     "examples": [
      {
       "en": "Sharks *can* swim.",
       "tr": "Köpek balıkları yüzebilir."
      },
      {
       "en": "Eagles *can* fly.",
       "tr": "Kartallar uçabilir."
      },
      {
       "en": "*Can* a cheetah run fast? — Yes, it can.",
       "tr": "Bir çita hızlı koşabilir mi? — Evet."
      }
     ]
    },
    {
     "title": "can't ⛔",
     "tone": "bad",
     "examples": [
      {
       "en": "Elephants *can't* climb trees.",
       "tr": "Filler ağaçlara tırmanamaz."
      },
      {
       "en": "Lions *can't* talk.",
       "tr": "Aslanlar konuşamaz."
      },
      {
       "en": "*Can* a penguin fly? — No, it can't.",
       "tr": "Bir penguen uçabilir mi? — Hayır."
      }
     ]
    }
   ]
  },
  {
   "type": "exercise",
   "title": "Activity Break",
