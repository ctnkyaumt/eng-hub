  {
   "type": "grammar",
   "title": "Comparative Adjectives",
   "titleTr": "Karşılaştırma sıfatları — than",
   "rule": "Tek heceli + *-er* · \"e\" ile biten + *-r* · sessiz-sesli-sessiz → son harf çiftlenir + *-er* · sessiz+y → *-ier* · iki+ heceli → *more* + sıfat",
   "examples": [
    {
     "en": "fast → fast*er*  ·  large → large*r*  ·  big → big*ger*",
     "tr": "tek heceli"
    },
    {
     "en": "heavy → heav*ier*  ·  dangerous → *more* dangerous",
     "tr": "iki+ heceli"
    },
    {
     "en": "good → *better* · bad → *worse* · much/many → *more* · little → *less* · far → *farther*",
     "tr": "düzensiz"
    },
    {
     "en": "Lions are *stronger than* leopards.",
     "tr": "Aslanlar, leoparlardan daha güçlüdür."
    },
    {
     "en": "Bears are *bigger than* wolves.",
     "tr": "Ayılar, kurtlardan daha büyüktür."
    },
    {
     "en": "Elephants are *heavier than* gorillas.",
     "tr": "Filler, gorillerden daha ağırdır."
    },
    {
     "en": "Tigers are *more dangerous than* zebras.",
     "tr": "Kaplanlar, zebralardan daha tehlikelidir."
    },
    {
     "en": "Crocodiles are *scarier than* snakes.",
     "tr": "Timsahlar, yılanlardan daha korkutucudur."
    }
   ]
  },
  {
   "type": "exercise",
   "title": "Activity Break",
   "titleTr": "Use what you just learned · Comparative Adjectives",
