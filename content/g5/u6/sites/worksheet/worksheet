        selectedC = null; updateCDefs();
      } else if (blank.dataset.current) {
        returnCDef(blank.dataset.current);
        blank.innerHTML = '&nbsp;&nbsp;&nbsp;';
        delete blank.dataset.current;
        blank.classList.remove('ans-correct','ans-wrong');
      }
    });

    row.appendChild(num);
    row.appendChild(label);
    row.appendChild(blank);
    wordsSide.appendChild(row);
  });
}

function useCDef(l)    { const c = document.getElementById('cdef-' + l); if (c) c.classList.add('c-def-used'); }
function returnCDef(l) { const c = document.getElementById('cdef-' + l); if (c) c.classList.remove('c-def-used'); }

function updateCDefs() {
  C_DEFS.forEach(d => {
    const c = document.getElementById('cdef-' + d.letter);
    if (!c) return;
    c.classList.toggle('c-def-selected', selectedC === d.letter && !c.classList.contains('c-def-used'));
