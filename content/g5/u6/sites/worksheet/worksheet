];

let selectedA = null;

function chipId(w) { return 'achip-' + w.replace(/\s+/g, '-'); }

function buildSectionA() {
  const wrap = document.getElementById('sectionA');
  wrap.innerHTML = '';
  A_GROUPS.forEach((group, gi) => {
    const bankWrap = document.createElement('div');
    bankWrap.className = 'word-bank-wrap';
    const bank = document.createElement('div');
    bank.className = 'word-bank';
    bank.id = 'wordBankA' + gi;
    group.words.forEach(w => {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.id = chipId(w);
      chip.textContent = w;
      chip.dataset.word = w;
      chip.draggable = true;
      chip.addEventListener('dragstart', e => e.dataTransfer.setData('text', w));
      chip.addEventListener('click', () => {
        if (chip.classList.contains('chip-used')) return;
        selectedA = (selectedA === w) ? null : w;
        updateAChips();
      });
      bank.appendChild(chip);
    });
    bankWrap.appendChild(bank);
    wrap.appendChild(bankWrap);

    const grid = document.createElement('div');
    grid.className = 'picture-grid';
    group.images.forEach(item => {
      const card = document.createElement('div');
      card.className = 'pic-card';

      const img = document.createElement('img');
      img.src = item.img; img.alt = item.ans;
      card.appendChild(img);

      const badge = document.createElement('div');
      badge.className = 'pic-num';
      badge.textContent = item.id;
      card.appendChild(badge);

      const bottom = document.createElement('div');
      bottom.className = 'pic-bottom';

      const blank = document.createElement('span');
      blank.className = 'pic-blank';
      blank.id = 'ablank-' + item.id;
      blank.dataset.ans = item.ans;
      blank.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
      blank.addEventListener('dragover', e => { e.preventDefault(); blank.classList.add('dov'); });
      blank.addEventListener('dragleave', () => blank.classList.remove('dov'));
      blank.addEventListener('drop', e => {
        e.preventDefault(); blank.classList.remove('dov');
        placeWordA(blank, e.dataTransfer.getData('text'));
      });
      blank.addEventListener('click', () => {
        if (selectedA) { placeWordA(blank, selectedA); selectedA = null; updateAChips(); }
        else if (blank.dataset.current) { removeWordA(blank); }
      });

      const showBtn = document.createElement('button');
      showBtn.type = 'button';
      showBtn.className = 'btn-show';
      showBtn.textContent = 'Show';
      showBtn.addEventListener('click', () => {
        if (showBtn.classList.contains('shown')) {
          removeWordA(blank);
          showBtn.textContent = 'Show'; showBtn.classList.remove('shown');
        } else {
          placeWordA(blank, item.ans);
          blank.classList.remove('ans-correct','ans-wrong');
          showBtn.textContent = 'Hide'; showBtn.classList.add('shown');
        }
      });

      bottom.appendChild(blank);
      bottom.appendChild(showBtn);
      card.appendChild(bottom);
      grid.appendChild(card);
    });
    wrap.appendChild(grid);

    if (gi < A_GROUPS.length - 1) {
      const div = document.createElement('div');
      div.style.cssText = 'height:2px;background:#f0f0f0;margin:4px 14px;';
      wrap.appendChild(div);
    }
  });
}

function placeWordA(blank, word) {
  if (!word) return;
  if (blank.dataset.current) returnAChip(blank.dataset.current);
  document.querySelectorAll('.pic-blank').forEach(b => {
    if (b !== blank && b.dataset.current === word) {
      b.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
      delete b.dataset.current;
      b.classList.remove('ans-correct','ans-wrong');
    }
  });
  blank.textContent = word;
  blank.dataset.current = word;
  blank.classList.remove('ans-correct','ans-wrong');
  if (word === blank.dataset.ans) blank.classList.add('ans-correct');
  else blank.classList.add('ans-wrong');
  useAChip(word);
}

function removeWordA(blank) {
  const w = blank.dataset.current;
  blank.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
  delete blank.dataset.current;
  blank.classList.remove('ans-correct','ans-wrong');
  returnAChip(w);
}

function useAChip(w)    { const c = document.getElementById(chipId(w)); if (c) c.classList.add('chip-used'); }
function returnAChip(w) { const c = document.getElementById(chipId(w)); if (c) c.classList.remove('chip-used'); }

function updateAChips() {
  A_GROUPS.forEach(g => g.words.forEach(w => {
    const c = document.getElementById(chipId(w));
    if (!c) return;
    c.classList.toggle('chip-selected', selectedA === w && !c.classList.contains('chip-used'));
  }));
}

function checkA() {
  let ok = 0, total = 0;
  document.querySelectorAll('.pic-blank').forEach(b => {
    total++;
    b.classList.remove('ans-correct','ans-wrong');
    if (b.dataset.current) {
      if (b.dataset.current === b.dataset.ans) { b.classList.add('ans-correct'); ok++; }
      else b.classList.add('ans-wrong');
    }
  });
  const el = document.getElementById('scoreElA');
  el.style.color = ok === total ? '#2E7D32' : ok >= total / 2 ? '#E65100' : '#B71C1C';
  el.textContent = ok === total ? `🎉 Perfect! ${ok} / ${total} — Well done!` : `Score: ${ok} / ${total}`;
}

function resetA() {
  document.querySelectorAll('.pic-blank').forEach(b => {
    b.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
    delete b.dataset.current;
    b.classList.remove('ans-correct','ans-wrong');
  });
  document.querySelectorAll('#sectionA .btn-show').forEach(btn => { btn.textContent = 'Show'; btn.classList.remove('shown'); });
  A_GROUPS.forEach(g => g.words.forEach(returnAChip));
  selectedA = null; updateAChips();
  document.getElementById('scoreElA').textContent = '';
}

buildSectionA();

// ═══════════════════════════════════
//           SECTION  B
// ═══════════════════════════════════
const B_WORDS = ['cup', 'bowl', 'pot', 'bottle', 'glass', 'tablespoon'];
const B_ITEMS = [
  { id:'b1', img:'images/chapterB-a-bowl-of-soup.png',       suffix:'of soup',   ans:'bowl' },
