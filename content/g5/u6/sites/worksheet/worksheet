  },
  {
    words:  ['butter', 'tomatoes', 'flour', 'chicken', 'croissant'],
    images: [
      { id:6,  ans:'butter',    img:'images/butter.png' },
      { id:7,  ans:'tomatoes',  img:'images/tomatoes.png' },
      { id:8,  ans:'flour',     img:'images/flour.png' },
