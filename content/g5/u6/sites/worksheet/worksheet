}

function checkC() {
  let ok = 0;
  document.querySelectorAll('.c-blank').forEach(b => {
    b.classList.remove('ans-correct','ans-wrong');
    if (b.dataset.current) {
      if (b.dataset.current === b.dataset.ans) { b.classList.add('ans-correct'); ok++; }
      else b.classList.add('ans-wrong');
    }
  });
  const el = document.getElementById('scoreElC');
  el.style.color = ok === C_WORDS.length ? '#2E7D32' : ok >= C_WORDS.length / 2 ? '#E65100' : '#B71C1C';
  el.textContent = ok === C_WORDS.length ? `🎉 Perfect! ${ok} / ${C_WORDS.length}` : `Score: ${ok} / ${C_WORDS.length}`;
}

function showAllC() {
  C_WORDS.forEach(w => {
    const b = document.getElementById('cblank-' + w.num);
    if (b && b.dataset.current) returnCDef(b.dataset.current);
    if (b) { b.textContent = w.ans; b.dataset.current = w.ans; b.classList.remove('ans-correct','ans-wrong'); useCDef(w.ans); }
  });
  selectedC = null; updateCDefs();
}

function resetC() {
  document.querySelectorAll('.c-blank').forEach(b => {
    if (b.dataset.current) returnCDef(b.dataset.current);
    b.innerHTML = '&nbsp;&nbsp;&nbsp;';
    delete b.dataset.current;
    b.classList.remove('ans-correct','ans-wrong');
