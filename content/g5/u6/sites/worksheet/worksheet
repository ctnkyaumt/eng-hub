    blank.id = 'cblank-' + w.num;
    blank.dataset.ans = w.ans;
    blank.innerHTML = '&nbsp;&nbsp;&nbsp;';
    blank.addEventListener('click', () => {
      if (selectedC) {
        if (blank.dataset.current) returnCDef(blank.dataset.current);
        blank.textContent = selectedC;
        blank.dataset.current = selectedC;
        blank.classList.remove('ans-correct','ans-wrong');
        if (selectedC === blank.dataset.ans) blank.classList.add('ans-correct');
        else blank.classList.add('ans-wrong');
