    blank.addEventListener('click', () => {
      if (selectedB) { placeBWord(blank, selectedB); selectedB = null; updateBChips(); }
      else if (blank.dataset.current) { removeBWord(blank); }
    });

    bottom.appendChild(document.createTextNode('a '));
    bottom.appendChild(blank);
    bottom.appendChild(document.createTextNode(' ' + item.suffix));
    card.appendChild(bottom);
    grid.appendChild(card);
  });
}

function placeBWord(blank, word) {
  if (!word) return;
  if (blank.dataset.current) returnBChip(blank.dataset.current);
  document.querySelectorAll('.b-blank').forEach(b => {
    if (b !== blank && b.dataset.current === word) {
      b.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;';
      delete b.dataset.current;
      b.classList.remove('ans-correct','ans-wrong');
    }
