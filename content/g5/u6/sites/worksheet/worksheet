function useBChip(w)    { const c = document.getElementById('bchip-' + w); if (c) c.classList.add('b-chip-used'); }
function returnBChip(w) { const c = document.getElementById('bchip-' + w); if (c) c.classList.remove('b-chip-used'); }

function updateBChips() {
  B_WORDS.forEach(w => {
    const c = document.getElementById('bchip-' + w);
    if (!c) return;
