const E_STEPS = [
  { text:'Add flour and stir quickly to make a dough.',   ans:3 },
  { text:'Wash your hands and clean your cooking area.',  ans:1 },
  { text:'Cover the churros with sugar. Enjoy!',          ans:5 },
  { text:'Heat water, sugar, salt, and butter until it boils.', ans:2 },
  { text:'Fry the churros until they turn golden brown.', ans:4 },
];

let selectedE = null;

function buildSectionE() {
  const bank = document.getElementById('eNumBank');
  bank.innerHTML = '';
  [1,2,3,4,5].forEach(n => {
    const chip = document.createElement('div');
    chip.className = 'e-num-chip';
    chip.id = 'echip-' + n;
    chip.textContent = n;
    chip.draggable = true;
    chip.addEventListener('dragstart', e => { e.dataTransfer.setData('text', String(n)); selectedE = null; updateEChips(); });
    chip.addEventListener('click', () => {
      selectedE = (selectedE === n) ? null : n;
      updateEChips();
    });
    bank.appendChild(chip);
  });

  const wrap = document.getElementById('eSteps');
  wrap.innerHTML = '';
  E_STEPS.forEach((s, i) => {
    const step = document.createElement('div');
    step.className = 'e-step';

    const blank = document.createElement('div');
    blank.className = 'e-num-blank';
    blank.id = 'eblank-' + i;
    blank.dataset.ans = s.ans;
    blank.dataset.val = '';

    blank.addEventListener('dragover', e => { e.preventDefault(); blank.classList.add('dov'); });
    blank.addEventListener('dragleave', () => blank.classList.remove('dov'));
    blank.addEventListener('drop', e => {
      e.preventDefault(); blank.classList.remove('dov');
      placeE(blank, parseInt(e.dataTransfer.getData('text'), 10));
    });
    blank.addEventListener('click', () => {
      if (selectedE !== null) {
        placeE(blank, selectedE);
        selectedE = null;
        updateEChips();
      } else if (blank.dataset.val) {
        blank.dataset.val = '';
        blank.textContent = '';
        blank.classList.remove('e-correct','e-wrong');
        updateEChips();
      }
    });

    const text = document.createElement('span');
    text.textContent = s.text;
    step.appendChild(blank);
    step.appendChild(text);
    wrap.appendChild(step);
  });
}

function placeE(blank, n) {
  // Eğer bu sayı başka bir blank'teyse oradan kaldır
  document.querySelectorAll('.e-num-blank').forEach(b => {
    if (b !== blank && parseInt(b.dataset.val, 10) === n) {
      b.dataset.val = ''; b.textContent = '';
      b.classList.remove('e-correct','e-wrong');
    }
  });
  blank.dataset.val = n;
  blank.textContent = n;
  if (n === parseInt(blank.dataset.ans, 10)) {
    blank.classList.add('e-correct');
  } else {
    blank.classList.add('e-wrong');
  }
  updateEChips();
}

function updateEChips() {
  const placed = new Set();
  document.querySelectorAll('.e-num-blank').forEach(b => {
    if (b.dataset.val) placed.add(parseInt(b.dataset.val, 10));
  });
  [1,2,3,4,5].forEach(n => {
    const chip = document.getElementById('echip-' + n);
    if (!chip) return;
    chip.classList.remove('e-chip-used','e-chip-selected');
    if (placed.has(n)) chip.classList.add('e-chip-used');
    else if (selectedE === n) chip.classList.add('e-chip-selected');
  });
}

function checkE() {
  let ok = 0;
  E_STEPS.forEach((s, i) => {
    const blank = document.getElementById('eblank-' + i);
    blank.classList.remove('e-correct','e-wrong');
    const val = parseInt(blank.dataset.val, 10);
    if (!isNaN(val)) {
      if (val === s.ans) { blank.classList.add('e-correct'); ok++; }
      else blank.classList.add('e-wrong');
    }
  });
  const el = document.getElementById('scoreElE');
  el.style.color = ok === E_STEPS.length ? '#2E7D32' : ok >= E_STEPS.length / 2 ? '#E65100' : '#B71C1C';
  el.textContent = ok === E_STEPS.length ? `🎉 Perfect! ${ok} / ${E_STEPS.length}` : `Score: ${ok} / ${E_STEPS.length}`;
}

function showAllE() {
  E_STEPS.forEach((s, i) => {
    const blank = document.getElementById('eblank-' + i);
    blank.dataset.val = s.ans;
    blank.textContent = s.ans;
    blank.classList.remove('e-correct','e-wrong');
  });
  selectedE = null;
  updateEChips();
}

function resetE() {
  E_STEPS.forEach((s, i) => {
    const blank = document.getElementById('eblank-' + i);
    blank.dataset.val = '';
    blank.textContent = '';
    blank.classList.remove('e-correct','e-wrong');
  });
  selectedE = null;
  updateEChips();
  document.getElementById('scoreElE').textContent = '';
}

buildSectionE();

