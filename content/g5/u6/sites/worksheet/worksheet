    blank.dataset.ans = item.ans;
    blank.innerHTML = '&nbsp;&nbsp;&nbsp;&nbsp;';
    blank.addEventListener('dragover', e => { e.preventDefault(); blank.classList.add('dov'); });
    blank.addEventListener('dragleave', () => blank.classList.remove('dov'));
    blank.addEventListener('drop', e => {
      e.preventDefault(); blank.classList.remove('dov');
      placeBWord(blank, e.dataTransfer.getData('text'));
