function buildSectionB() {
  const bank = document.getElementById('wordBankB');
  B_WORDS.forEach(w => {
    const chip = document.createElement('span');
    chip.className = 'b-chip';
    chip.id = 'bchip-' + w;
    chip.textContent = w;
    chip.dataset.word = w;
    chip.draggable = true;
    chip.addEventListener('dragstart', e => e.dataTransfer.setData('text', w));
    chip.addEventListener('click', () => {
      if (chip.classList.contains('b-chip-used')) return;
