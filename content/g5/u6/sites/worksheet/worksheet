<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
    <meta name="google" content="notranslate">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Year 5 Theme 6 Worksheet | Canbay İngilizce</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Arial, sans-serif;
  background: #e8edf2;
  padding: 14px 10px 80px;
  min-height: 100vh;
}

.page {
  background: #fff;
  max-width: 1900px;
  margin: 0 auto;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 6px 30px rgba(0,0,0,0.12);
}

/* ── Color bar ── */
.color-bar { display: flex; height: 15px; }
.color-bar span { flex: 1; }
.cb1 { background: #EF9A9A; }
.cb2 { background: #A5D6A7; }
.cb3 { background: #90CAF9; }
.cb4 { background: #FFF176; }

/* ── Header ── */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 14px 12px;
  border-bottom: 2px solid #f0f0f0;
}
.year-badge {
  background: #FFC107; color: #000;
  font-size: 20px; font-weight: 800;
  padding: 5px 16px; border-radius: 7px;
  white-space: nowrap; text-decoration: none;
  transition: all 0.18s; display: inline-block;
}
.year-badge:hover { background: #FFB300; transform: translateY(-1px); }
.page-title {
  font-size: 22px; font-weight: 900; color: #E53935;
  text-transform: uppercase; letter-spacing: 0.6px;
  text-align: center; flex: 1; padding: 0 12px;
}
.canbay-logo {
  font-size: 13px; font-weight: 800; color: #E53935;
  white-space: nowrap; text-decoration: none; background: #fff;
  border: 2px solid #E53935; border-radius: 8px;
  padding: 5px 14px; transition: all 0.18s; display: inline-block;
}
.canbay-logo:hover { background: #FFEBEE; transform: translateY(-1px); }
.fullscreen-btn {
  font-size: 13px; font-weight: 800; color: #1565C0;
  background: #fff; border: 2px solid #1565C0;
  border-radius: 8px; padding: 6px 14px; cursor: pointer;
  font-family: inherit; transition: all 0.18s; white-space: nowrap;
}
.fullscreen-btn:hover { background: #E3F2FD; transform: translateY(-1px); }

/* ── Student info ── */
.student-info {
  display: flex; gap: 50px;
  padding: 11px 14px;
  font-size: 20px; font-weight: 600; color: #000;
  border-bottom: 1px solid #f0f0f0;
}
.student-info input {
  border: none; border-bottom: 2px solid #555;
  font-size: 20px; width: 220px;
  outline: none; padding: 2px 4px; font-family: inherit;
}
.input-class { width: 90px; }

/* ── Instruction note ── */
.instruction-note {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 14px;
  background: #E3F2FD; border-left: 4px solid #1565C0;
  font-size: 20px; font-weight: 600; color: #000;
}
.instruction-note span { font-size: 20px; }

/* ── Section heading ── */
.section-header {
  font-size: 20px; font-weight: 700; color: #E53935;
  padding: 16px 14px 10px;
}

/* ── Section divider ── */
.section-divider {
  height: 3px;
  background: linear-gradient(to right,#FF5722,#E91E63,#FFC107,#009688,#FF5722,#E91E63,#FFC107,#009688);
  margin: 6px 0;
}

/* ── SECTION A: word bank + picture grid ── */
.word-bank-wrap { padding: 0 14px 16px; }
.word-bank {
  display: flex; flex-wrap: wrap; gap: 10px;
  padding: 14px 18px;
  background: #FFFDE7; border: 2px dashed #FFC107; border-radius: 12px;
}
.chip {
  background: #fff; border: 2.5px solid #FF5722;
  border-radius: 20px; padding: 7px 18px;
  font-size: 20px; font-weight: 700; color: #000;
  cursor: pointer; user-select: none; transition: all 0.18s;
}
.chip:hover:not(.chip-used) { background: #FBE9E7; transform: translateY(-2px); }
.chip.chip-selected { background: #FF5722; color: #fff; border-color: #FF5722; box-shadow: 0 3px 10px rgba(255,87,34,0.4); }
.chip.chip-used { opacity: 0.18; cursor: default; pointer-events: none; }

.picture-grid {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 12px; padding: 4px 14px 16px;
}
.pic-card {
  border: 2px solid #e0e0e0; border-radius: 12px;
  overflow: hidden; background: #fafafa;
  position: relative; display: flex; flex-direction: column;
}
.pic-card img { width: 100%; display: block; object-fit: cover; aspect-ratio: 1/1; }
.pic-num {
  position: absolute; top: 6px; left: 6px;
  background: #FF5722; color: #fff;
  width: 22px; height: 22px; border-radius: 50%;
  font-size: 11px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.pic-bottom {
  display: flex; align-items: center; justify-content: center; gap: 4px;
  padding: 7px 4px 9px; background: #fafafa;
  border-top: 1px solid #eee; margin-top: auto;
}
.pic-blank {
  display: inline-block; min-width: 120px;
  padding: 2px 8px; border-bottom: 2.5px solid #888;
  font-weight: 700; font-size: 23px; color: #1565C0;
  text-align: center; cursor: pointer; transition: all 0.15s; white-space: nowrap;
}
.pic-blank.dov { background: #FFF8E1; border-bottom-color: #FFC107; }
.pic-blank.ans-correct { color: #1B5E20; border-bottom-color: #4CAF50; }
.pic-blank.ans-wrong   { color: #B71C1C; border-bottom-color: #F44336; }

.btn-show {
  background: none; border: 1.8px solid #9E9E9E; border-radius: 12px;
  font-size: 11px; font-weight: 700; color: #000;
  padding: 2px 9px; cursor: pointer; margin-left: 4px;
  font-family: inherit; transition: all 0.15s;
}
.btn-show:hover { background: #F5F5F5; border-color: #FF5722; color: #FF5722; }
.btn-show.shown { background: #FFF3E0; border-color: #FF5722; color: #FF5722; }

/* ── SECTION B: fill in blanks (measurement) ── */
.b-wordbank-wrap { padding: 0 14px 16px; }
.b-word-bank {
  display: flex; flex-wrap: wrap; gap: 10px;
  padding: 14px 18px;
  background: #E8F5E9; border: 2px dashed #66BB6A; border-radius: 12px;
}
.b-chip {
  background: #fff; border: 2.5px solid #2E7D32;
  border-radius: 20px; padding: 7px 18px;
  font-size: 20px; font-weight: 700; color: #1B5E20;
  cursor: pointer; user-select: none; transition: all 0.18s;
}
.b-chip:hover:not(.b-chip-used) { background: #E8F5E9; transform: translateY(-2px); }
.b-chip.b-chip-selected { background: #2E7D32; color: #fff; border-color: #2E7D32; box-shadow: 0 3px 10px rgba(46,125,50,0.4); }
.b-chip.b-chip-used { opacity: 0.18; cursor: default; pointer-events: none; }

.b-img-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 14px; padding: 4px 14px 16px;
}
.b-img-card {
  border: 2px solid #C8E6C9; border-radius: 14px;
  overflow: hidden; background: #F9FBF9;
  display: flex; flex-direction: column; align-items: center;
}
.b-img-card img { width: 100%; max-height: 180px; object-fit: contain; padding: 10px; }
.b-img-bottom {
  padding: 8px 10px 12px; text-align: center;
  font-size: 20px; font-weight: 600; color: #000;
  width: 100%;
}
.b-blank {
  display: inline-block; min-width: 110px;
  padding: 2px 8px; border-bottom: 2.5px solid #888;
  font-weight: 700; font-size: 23px; color: #1565C0;
  text-align: center; cursor: pointer; transition: all 0.15s;
}
.b-blank.dov { background: #FFF8E1; border-bottom-color: #FFC107; }
.b-blank.ans-correct { color: #1B5E20; border-bottom-color: #4CAF50; background: #E8F5E9; border-radius: 6px; }
.b-blank.ans-wrong   { color: #B71C1C; border-bottom-color: #F44336; background: #FFEBEE; border-radius: 6px; }

/* ── SECTION C: matching ── */
.c-match-wrap {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 20px; padding: 4px 14px 16px;
}
.c-defs-side {
  background: #F3E5F5; border: 2px solid #CE93D8;
  border-radius: 14px; padding: 14px 16px;
  display: flex; flex-direction: column; gap: 8px;
}
.c-def-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 9px 12px; border-radius: 10px;
  background: #fff; border: 2px solid #CE93D8;
  font-size: 20px; font-weight: 600; color: #000;
  cursor: pointer; transition: all 0.15s;
}
.c-def-item:hover { background: #F3E5F5; }
.c-def-item.c-def-selected { background: #7E57C2; color: #fff; border-color: #7E57C2; }
.c-def-item.c-def-used { opacity: 0.3; cursor: default; pointer-events: none; }
.c-def-letter {
  background: #7E57C2; color: #fff;
  border-radius: 6px; width: 28px; height: 28px; flex-shrink: 0;
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.c-def-item.c-def-selected .c-def-letter { background: #fff; color: #7E57C2; }

.c-words-side {
  display: flex; flex-direction: column; gap: 10px;
}
.c-word-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 14px;
  background: #F8F9FA; border: 2px solid #E0E0E0; border-radius: 10px;
}
.c-word-num { font-size: 20px; font-weight: 800; color: #7E57C2; min-width: 24px; }
.c-word-label { font-size: 20px; font-weight: 800; color: #000; min-width: 90px; }
.c-blank {
  display: inline-block; min-width: 50px;
  padding: 2px 10px; border-bottom: 2.5px solid #888;
  font-weight: 800; font-size: 23px; color: #7E57C2;
  text-align: center; cursor: pointer; transition: all 0.15s; margin-left: 4px;
}
.c-blank.dov { background: #FFF8E1; border-bottom-color: #FFC107; }
.c-blank.ans-correct { color: #1B5E20; border-bottom-color: #4CAF50; background: #E8F5E9; border-radius: 6px; }
.c-blank.ans-wrong   { color: #B71C1C; border-bottom-color: #F44336; background: #FFEBEE; border-radius: 6px; }

/* ── SECTION D: How many / How much ── */
.d-q-list {
  padding: 4px 14px 16px;
  display: flex; flex-direction: column; gap: 10px;
}
.d-q-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  background: #F8F9FA; border: 2px solid #E0E0E0; border-radius: 10px;
  font-size: 20px; font-weight: 600; color: #000;
}
.d-q-num { font-size: 20px; font-weight: 800; color: #1565C0; min-width: 28px; }
.d-toggle-group { display: flex; gap: 6px; }
.d-toggle-btn {
  border: 2px solid #B0BEC5; border-radius: 10px;
  background: #fff; padding: 5px 14px;
  font-size: 20px; font-weight: 700; color: #555;
  cursor: pointer; font-family: inherit; transition: all 0.15s;
}
.d-toggle-btn:hover { border-color: #1565C0; background: #E3F2FD; }
.d-toggle-btn.d-selected { background: #1565C0; color: #fff; border-color: #1565C0; }
.d-toggle-btn.d-correct  { background: #E8F5E9; color: #1B5E20; border-color: #4CAF50; }
.d-toggle-btn.d-wrong    { background: #FFEBEE; color: #B71C1C; border-color: #F44336; }
.d-q-text { font-size: 20px; font-weight: 600; }

/* ── SECTION E: recipe order ── */
.e-num-bank {
  display: flex; gap: 12px; padding: 4px 14px 14px; flex-wrap: wrap;
}
.e-num-chip {
  width: 56px; height: 56px; border-radius: 10px;
  border: 2.5px solid #FFC107; background: #fff;
  font-size: 28px; font-weight: 900; color: #E65100;
  display: flex; align-items: center; justify-content: center;
  cursor: grab; -webkit-user-select: none; user-select: none; transition: all 0.18s;
}
.e-num-chip:hover:not(.e-chip-used) { background: #FFF8E1; transform: translateY(-2px); }
.e-num-chip.e-chip-selected { background: #FF5722; color: #fff; border-color: #FF5722; box-shadow: 0 3px 10px rgba(255,87,34,0.4); }
.e-num-chip.e-chip-used { opacity: 0.18; cursor: default; pointer-events: none; }
.e-wrap {
  display: grid; grid-template-columns: minmax(50%, 1fr) 1fr;
  gap: 20px; padding: 4px 14px 16px; align-items: start;
}
.e-steps { display: flex; flex-direction: column; gap: 10px; }
.e-step {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 14px;
  background: #FFF8E1; border: 2px solid #FFD54F; border-radius: 10px;
  font-size: 20px; font-weight: 600; color: #000;
}
.e-num-blank {
  width: 56px; height: 50px; border-radius: 8px;
  border: 2.5px dashed #FFC107; background: #fff;
  font-size: 28px; font-weight: 900; color: #E65100;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; flex-shrink: 0; transition: all 0.15s;
}
.e-num-blank.dov { background: #FFF8E1; border-style: solid; border-color: #FFC107; }
.e-num-blank.e-correct { border-color: #4CAF50; color: #1B5E20; background: #E8F5E9; border-style: solid; }
.e-num-blank.e-wrong   { border-color: #F44336; color: #B71C1C; background: #FFEBEE; border-style: solid; }
.e-images { display: flex; flex-direction: column; gap: 10px; }
.e-images img { width: 100%; border-radius: 10px; border: 2px solid #e0e0e0; display: block; }

/* ── SECTION F: T/F ── */
.f-layout {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 18px; padding: 4px 14px 16px;
}
.f-text-box {
  background: #FFFDE7; border: 2px solid #FFC107;
  border-radius: 12px; padding: 16px 18px;
  font-size: 20px; line-height: 1.75; color: #000;
  align-self: start;
}
.f-q-list { display: flex; flex-direction: column; gap: 10px; }
.f-q-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  background: #F8F9FA; border: 2px solid #E0E0E0; border-radius: 10px;
}
.f-q-num { font-size: 20px; font-weight: 800; color: #E53935; min-width: 28px; }
.f-q-text { font-size: 20px; font-weight: 600; color: #000; flex: 1; line-height: 1.4; }
.f-tf-group { display: flex; gap: 6px; flex-shrink: 0; }
.f-tf-btn {
  border: 2px solid #B0BEC5; border-radius: 8px;
  background: #fff; width: 44px; height: 38px;
  font-size: 20px; font-weight: 800; color: #555;
  cursor: pointer; font-family: inherit; transition: all 0.15s;
}
.f-tf-btn:hover { border-color: #1565C0; background: #E3F2FD; }
.f-tf-btn.f-selected { background: #1565C0; color: #fff; border-color: #1565C0; }
.f-tf-btn.f-correct  { background: #4CAF50; color: #fff; border-color: #4CAF50; }
.f-tf-btn.f-wrong    { background: #F44336; color: #fff; border-color: #F44336; }

/* ── Buttons & score ── */
.btn-row { display: flex; justify-content: center; gap: 16px; padding: 14px; }
.btn {
  border: none; border-radius: 28px;
  font-size: 20px; font-weight: 700; padding: 12px 36px;
  cursor: pointer; font-family: inherit; transition: all 0.2s;
}
.btn-check { background: #FF5722; color: #fff; }
.btn-check:hover { background: #E64A19; transform: translateY(-2px); }
.btn-reset { background: #607D8B; color: #fff; }
.btn-reset:hover { background: #455A64; }
.btn-top { background: #1565C0; color: #fff; }
.btn-top:hover { background: #0D47A1; transform: translateY(-2px); }
.score { text-align: center; font-size: 20px; font-weight: 700; min-height: 28px; padding-bottom: 12px; }

/* ── Copyright ── */
.copyright {
  text-align: center; padding: 14px 14px 10px;
  font-size: 12px; color: #000; font-weight: 600;
  border-top: 1px solid #f0f0f0;
}

/* ── Bottom bar ── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9999;
  background: #fff; border-top: 3px solid #7B1C1C;
  display: flex; align-items: center; justify-content: center;
  gap: 12px; padding: 10px 20px;
  box-shadow: 0 -3px 16px rgba(0,0,0,0.15);
}
.bar-btn { border: none; border-radius: 8px; font-size: 14px; font-weight: 800; padding: 8px 18px; cursor: pointer; font-family: inherit; transition: all 0.18s; white-space: nowrap; }
.bar-btn-fs { background: #7B1C1C; color: #fff; border: 2px solid #7B1C1C; }
.bar-btn-fs:hover { background: #5D1010; border-color: #5D1010; }
.bar-btn-zoom { background: transparent; color: #7B1C1C; border: 2px solid rgba(123,28,28,0.4); font-size: 18px; padding: 6px 16px; }
.bar-btn-zoom:hover { background: rgba(123,28,28,0.08); border-color: #7B1C1C; }
.bar-zoom-label { color: #555; font-size: 13px; font-weight: 700; min-width: 40px; text-align: center; }
.bar-divider { width: 1px; height: 32px; background: rgba(123,28,28,0.2); flex-shrink: 0; }
.bar-btn-draw { background: transparent; color: #333; border: 2px solid rgba(0,0,0,0.2); font-size: 13px; padding: 7px 14px; gap: 5px; display: flex; align-items: center; }
.bar-btn-draw:hover { background: rgba(0,0,0,0.06); border-color: #555; }
.bar-btn-draw.active { background: #7B1C1C; color: #fff; border-color: #7B1C1C; }
.bar-btn-draw.active-highlight { background: #FFF176; color: #333; border-color: #e6c800; }
.bar-btn-clear { background: transparent; color: #C62828; border: 2px solid rgba(198,40,40,0.35); font-size: 13px; padding: 7px 14px; }
.bar-btn-clear:hover { background: rgba(198,40,40,0.08); border-color: #C62828; }
.bar-btn-end { background: #7B1C1C; color: #fff; border: 2px solid #7B1C1C; font-size: 13px; padding: 7px 14px; }
.bar-btn-end:hover { background: #5D1010; border-color: #5D1010; }
.bar-btn-home { background: transparent; color: #7B1C1C; border: 2px solid rgba(123,28,28,0.4); border-radius: 8px; font-size: 20px; padding: 5px 12px; text-decoration: none; transition: all 0.18s; line-height: 1; }
.bar-btn-home:hover { background: rgba(123,28,28,0.08); border-color: #7B1C1C; }
.bar-logo { height: 32px; opacity: 0.7; flex-shrink: 0; }
.bar-clock { margin-left: auto; font-size: 18px; font-weight: 800; color: #7B1C1C; letter-spacing: 1px; flex-shrink: 0; }
#drawCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9998; pointer-events: none; cursor: crosshair; }
@media (max-width: 1024px) { .bottom-bar { display: none; } body { padding-bottom: 20px; } }
@media (max-width: 700px) {
  .picture-grid { grid-template-columns: repeat(2, 1fr); }
  .b-img-grid { grid-template-columns: repeat(2, 1fr); }
  .c-match-wrap { grid-template-columns: 1fr; }
  .f-layout { grid-template-columns: 1fr; }
  .e-wrap { grid-template-columns: 1fr; }
  .e-images img { width: 100%; }
  .page-title { font-size: 14px; }
}
</style>
</head>
<body>
<div class="page">

  <div class="color-bar">
    <span class="cb1"></span><span class="cb2"></span><span class="cb3"></span><span class="cb4"></span>
    <span class="cb1"></span><span class="cb2"></span><span class="cb3"></span><span class="cb4"></span>
  </div>

  <div class="page-header">
    <a href="../../" class="year-badge">Year 5</a>
    <div class="page-title">Theme 6 &nbsp;·&nbsp; Life in the World &nbsp;·&nbsp; Worksheet</div>
    <button type="button" class="fullscreen-btn" id="fsBtn" onclick="toggleFullscreen()">⛶ Tam Ekran</button>
    <a href="../../../" class="canbay-logo">© CANBAY</a>
  </div>

  <div class="student-info">
    <div>Student Name: <input type="text" spellcheck="false" title="Student Name" placeholder=" "></div>
    <div>Class: <input type="text" spellcheck="false" title="Class" placeholder=" " class="input-class"></div>
  </div>

  <div class="instruction-note">
    <span>📝</span> Bir kelimeye tıkla, ardından boşluğa tıkla — ya da kelimeyi sürükleyip boşluğa bırak.
  </div>

  <!-- ══ SECTION A ══ -->
  <div class="section-header">A. Write the words under the correct pictures.</div>
  <div id="sectionA"></div>
  <div class="btn-row">
    <button type="button" class="btn btn-check" onclick="checkA()">✓ Check Answers</button>
    <button type="button" class="btn btn-reset"  onclick="resetA()">↺ Reset</button>
  </div>
  <div class="score" id="scoreElA"></div>

  <!-- ══ SECTION B ══ -->
  <div class="section-divider"></div>
  <div class="section-header">B. Fill in the blanks with the correct word given in the box.</div>
  <div class="b-wordbank-wrap">
    <div class="b-word-bank" id="wordBankB"></div>
  </div>
  <div class="b-img-grid" id="bImgGrid"></div>
  <div class="btn-row">
    <button type="button" class="btn btn-check" onclick="checkB()">✓ Check Answers</button>
    <button type="button" class="btn btn-reset"  onclick="showAllB()">👁 Show All</button>
    <button type="button" class="btn btn-reset"  onclick="resetB()">↺ Reset</button>
  </div>
  <div class="score" id="scoreElB"></div>

  <!-- ══ SECTION C ══ -->
  <div class="section-divider"></div>
  <div class="section-header">C. Match the definitions with the words.</div>
  <div class="c-match-wrap">
    <div class="c-defs-side" id="cDefsSide"></div>
    <div class="c-words-side" id="cWordsSide"></div>
  </div>
