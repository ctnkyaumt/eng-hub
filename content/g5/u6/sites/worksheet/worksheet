}

function checkB() {
  let ok = 0, total = B_ITEMS.length;
  document.querySelectorAll('.b-blank').forEach(b => {
    b.classList.remove('ans-correct','ans-wrong');
    if (b.dataset.current) {
      if (b.dataset.current === b.dataset.ans) { b.classList.add('ans-correct'); ok++; }
