    item.addEventListener('click', () => {
      if (item.classList.contains('c-def-used')) return;
      selectedC = (selectedC === d.letter) ? null : d.letter;
      updateCDefs();
    });
    defsSide.appendChild(item);
  });

  const wordsSide = document.getElementById('cWordsSide');
  C_WORDS.forEach(w => {
    const row = document.createElement('div');
    row.className = 'c-word-item';

    const num = document.createElement('span');
    num.className = 'c-word-num';
    num.textContent = w.num + '.';

    const label = document.createElement('span');
    label.className = 'c-word-label';
    label.textContent = w.word;

    const blank = document.createElement('span');
