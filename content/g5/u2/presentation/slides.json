   "type": "compare",
   "title": "Classroom Rules",
   "titleTr": "Sınıf kuralları — emir cümleleri",
   "rule": "Olumlu emir cümleleri fiilin yalın hâli ile, olumsuz emir cümleleri *don't* ile başlar.",
   "columns": [
    {
     "title": "DO ✅",
     "tone": "good",
     "examples": [
      {
       "en": "Listen to your teachers carefully.",
       "tr": "Öğretmenlerini dikkatlice dinle."
      },
      {
       "en": "Bring the school materials.",
       "tr": "Okul materyallerini getir."
      },
      {
       "en": "Raise your hand to speak.",
       "tr": "Konuşmak için elini kaldır."
      },
