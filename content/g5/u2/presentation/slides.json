  {
   "type": "grammar",
   "title": "have got / has got",
   "titleTr": "Derslerimizden bahsederken",
   "rule": "I / You / We / They → *have got*.  He / She / It → *has got*.  Günlerden önce *on*, saatlerden önce *at* kullanılır.",
   "examples": [
    {
     "en": "I *have got* a Science class *at* nine o'clock *on* Monday.",
     "tr": "Ben Pazartesi günü saat dokuzda bir Fen Bilimleri dersine sahibim.",
     "img": "p05-02.png"
    },
    {
     "en": "He *has got* double Maths classes *at* half past ten *on* Friday.",
     "tr": "O Cuma günü saat on buçukta iki Matematik dersine sahip.",
     "img": "p05-01.png"
    },
    {
     "en": "You *have got* an English class *at* two o'clock *on* Wednesday.",
     "tr": "Sen Çarşamba günü saat ikide bir İngilizce dersine sahipsin."
    },
    {
     "en": "They *have got* a Music class *on* Tuesday.",
     "tr": "Onlar Salı günü bir Müzik dersine sahipler.",
     "img": "p05-07.png"
    },
    {
     "en": "She *has got* a P.E. class *at* eleven o'clock.",
     "tr": "O saat on birde bir Beden Eğitimi dersine sahip."
    }
   ]
  },
