   "type": "grammar",
   "title": "Comparative Adjectives",
   "titleTr": "Karşılaştırma sıfatları — than",
   "rule": "Tek heceli sıfat + *-er*. \"e\" ile bitiyorsa + *-r*. Sessiz-sesli-sessiz ise son harf çiftlenir + *-er*. İki+ heceli sıfatların önüne *more / less*. Karşılaştırırken *than* kullanılır.",
   "examples": [
    {
     "en": "small → small*er*",
     "tr": "tek heceli"
    },
    {
     "en": "wide → wide*r*",
     "tr": "e ile biten"
    },
    {
     "en": "big → big*ger*",
     "tr": "sessiz-sesli-sessiz"
    },
    {
     "en": "heavy → heav*ier*",
     "tr": "sessiz + y"
    },
    {
     "en": "crowded → *more* crowded",
     "tr": "iki+ heceli"
    },
    {
     "en": "good → *better*  ·  bad → *worse*  ·  much/many → *more*  ·  little → *less*  ·  far → *farther*",
     "tr": "düzensiz sıfatlar"
    },
    {
     "en": "The sofa is *more comfortable than* the armchair.",
     "tr": "Kanepe, koltuktan daha rahat."
    },
    {
     "en": "My flat is *closer than* your flat.",
     "tr": "Benim dairem, senin dairenden daha yakın."
    },
    {
     "en": "The terrace is *bigger than* the balcony.",
     "tr": "Teras, balkondan daha büyük."
    },
    {
     "en": "City life is *better than* town life.",
     "tr": "Şehir yaşamı, kasaba yaşamından daha iyidir.",
