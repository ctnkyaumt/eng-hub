# ENG HUB — what stays out of the repository
#
# The USB build is ~1.3 GB and most of it is other people's material (MEB course
# books, teacher worksheets from eltarena, activity banks, mirrored sites). The
# repository carries the program and the decks that were written for it; every
# downloaded file is rebuilt with the scripts in tools/.

# course books and theme sheets (MEB / publisher material)
res/

# bundled portable interpreter (21 MB, fetched by tools/get_python_win.py)
runtime/

# generated content
content/**/worksheets/*
!content/**/worksheets/manifest.json
content/**/games/
content/**/sites/
content/**/presentation/pages/
content/**/presentation/img/
content/**/presentation/*.bak

# freely licensed pictures fetched per word (tools/fetch_word_images.py)
app/img/words/*.jpg

# snapshots of the source catalogue
app/data/catalog.json
app/data/source-index.json
app/data/books.json
tools/cache/
tools/logs/

# python
__pycache__/
*.pyc
